---
// The top of the home page: you ask, your AI publishes, you share. Beside the
// title, a scene plays it with the demos of demo.cahut.cloud: a request is
// typed, the AI publishes the Window, then knocks to make it public.
import { getImage } from 'astro:assets';
import Icon from '../Icon.astro';
import { aiClients } from './ais';
import { examplesIn, heroScenes, bare } from './examples';
import { useTranslations, type Lang } from '../../i18n';
import { signupURL, myCahutURL } from '../../links';
import clouds from '@charte/illustrations/motif-nuages.svg?url';
import knockPicto from '@charte/icones/knock-first.svg?raw';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const { hero: t, base, examples: words, vocabulary, ais } = useTranslations(lang);
const account = base.account;

// The AI clients that publish to a Cahut, with the plans that let them.
const clients = aiClients.map((client, index) => ({ ...client, ...ais.clients[index] }));

// Each word of the title rises in turn, line after line.
let count = 0;
const lines = t.title.map((line) => line.split(' ').map((word) => ({ word, index: count++ })));

// The four demos that play, in the language of the page, with their request
// and their first screen.
const demos = examplesIn(lang);
const scenes = await Promise.all(
	heroScenes.map(async (id) => {
		const index = demos.findIndex((demo) => demo.id === id);
		const { url, room, image } = demos[index];
		return {
			prompt: words.items[index].prompt,
			url: bare(url),
			room: words.rooms[room],
			image: (await getImage({ src: image, width: 1200, format: 'webp' })).src,
		};
	}),
);

const access = [
	{ id: 'room', icon: 'lock', label: vocabulary.accessLabels.room },
	{ id: 'internal', icon: 'users', label: vocabulary.accessLabels.internal },
	{ id: 'key', icon: 'key-round', label: vocabulary.accessLabels.key },
	{ id: 'public', icon: 'globe', label: vocabulary.accessLabels.public },
] as const;

const picto = knockPicto
	.replace(/<title>.*?<\/title>/, '')
	.replace(/ role="img" aria-label="[^"]*"/, ' aria-hidden="true" focusable="false"')
	.replace(/ color="[^"]*"/, '');
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero__sky" style={`--clouds: url("${clouds}")`} aria-hidden="true"></div>
	<div class="container hero__grid">
		<div class="hero__text">
			<a class="hero__status" href="#roadmap">
				<span class="hero__pulse" aria-hidden="true"></span>
				{t.status}
				<Icon name="arrow-right" size={14} />
			</a>
			<h1 id="hero-title" class="c-display hero__title">
				{
					lines.map((line, number) => (
						<span class:list={['hero__line', { 'hero__line--last': number === lines.length - 1 }]}>
							{line.map(({ word, index }) => (
								<>
									<span class="word">
										<span style={`--i: ${index}`}>{word}</span>
									</span>{' '}
								</>
							))}
						</span>
					))
				}
			</h1>
			<p class="hero__lead">{t.lead}</p>
			<div class="hero__actions">
				<a class="c-btn c-btn--primary" href={signupURL(lang)}>{account.signup} <Icon name="arrow-right" /></a>
				<a class="c-btn c-btn--secondary" href="#quickstart">{t.install} <Icon name="arrow-down" /></a>
			</div>
			<div class="hero__under">
				<p class="hero__free">{account.free}</p>
				<p class="hero__member">
					<a href={myCahutURL}>{account.member} <Icon name="arrow-up-right" size={14} /></a>
				</p>
			</div>
			<div class="hero__ais">
				<p class="c-label">{ais.hero}</p>
				<ul class="hero__ai-list" role="list">
					{
						clients.map(({ name, short }) => (
							<li>
								<strong>{name}</strong>
								<span>{short}</span>
							</li>
						))
					}
				</ul>
				<a class="hero__ai-more" href="#ais">{ais.heroMore} <Icon name="arrow-down" size={14} /></a>
			</div>
		</div>

		<div
			class="stage"
			data-stage
			data-scenes={JSON.stringify(scenes)}
			data-approve={t.stage.approve}
			data-approved={t.stage.approved}
		>
			<p class="visually-hidden">{t.stage.label}</p>
			<div class="stage__browser" aria-hidden="true">
				<div class="stage__bar">
					<span class="stage__dots"><i></i><i></i><i></i></span>
					<span class="stage__address"><Icon name="lock" size={12} /><span class="c-mono" data-scene-address></span></span>
				</div>
				<div class="stage__view">
					<span class="stage__skeleton"></span>
					<img alt="" data-scene-shot />
				</div>
			</div>
			<div class="stage__chat" aria-hidden="true">
				<p class="stage__head">
					<span class="stage__ai"></span>{t.stage.ai}<span class="stage__clients">{t.stage.clients}</span>
				</p>
				<div class="stage__messages">
					<p class="bubble bubble--you" data-scene-prompt></p>
					<div class="bubble bubble--ai" data-scene-reply hidden>
						<p class="bubble__busy" data-scene-busy><span class="spinner"></span>{t.stage.publishing}</p>
						<p data-scene-done hidden>
							{t.stage.online} <strong data-scene-room></strong>{lang === 'fr' ? ' :' : ':'}<br /><span
								class="c-mono bubble__url"
								data-scene-url></span>
						</p>
					</div>
				</div>
			</div>
			<div class="stage__share" aria-hidden="true">
				<p class="c-label">{t.stage.access}</p>
				<ul class="stage__access" role="list">
					{
						access.map(({ id, icon, label }) => (
							<li class={`c-badge c-badge--${id}`} data-scene-access={id}>
								<Icon name={icon} size={14} />
								{label}
							</li>
						))
					}
				</ul>
				<div class="stage__knock" data-scene-knock hidden>
					<span class="stage__picto" set:html={picto} />
					<p><strong>Knock first.</strong> {t.stage.knock}</p>
					<span class="stage__approve" data-scene-approve-button>{t.stage.approve}</span>
				</div>
			</div>
			<div class="stage__controls">
				<div class="stage__steps" role="group" aria-label={t.stage.example}>
					{
						scenes.map((_, index) => (
							<button type="button" data-scene-step={index} aria-label={`${t.stage.example} ${index + 1}`} />
						))
					}
				</div>
				<a class="stage__more" href="#examples">{t.stage.more} <Icon name="arrow-down" size={14} /></a>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		overflow: clip;
	}

	/* The cloud pattern of the brand drifts slowly behind the page. */
	.hero__sky {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: var(--clouds);
		background-size: 160px 160px;
		opacity: 0.4;
		-webkit-mask-image: linear-gradient(to bottom, black 30%, transparent 95%);
		mask-image: linear-gradient(to bottom, black 30%, transparent 95%);
	}

	.hero__grid {
		display: grid;
		grid-template-columns: minmax(0, 11fr) minmax(0, 13fr);
		align-items: center;
		gap: var(--space-12);
		padding-block: var(--space-16) var(--space-24);
	}

	.hero__text {
		display: grid;
		justify-items: start;
		gap: var(--space-6);
	}

	.hero__status {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-1) var(--space-3) var(--space-1) var(--space-2);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-pill);
		background: var(--color-surface);
		color: var(--color-text-muted);
		font-size: var(--text-xs);
		line-height: var(--leading-xs);
		font-weight: var(--weight-semibold);
		text-decoration: none;
		box-shadow: var(--shadow-sm);
		transition: border-color var(--duration-base) var(--ease-out);
	}
	.hero__status:hover {
		border-color: var(--color-border-strong);
		color: var(--color-text);
	}
	.hero__status :global(.i) {
		transition: translate var(--duration-base) var(--ease-out);
	}
	.hero__status:hover :global(.i) {
		translate: 2px 0;
	}
	/* Someone is home: the yellow light of the door. */
	.hero__pulse {
		position: relative;
		width: var(--space-2);
		height: var(--space-2);
		border-radius: 50%;
		background: var(--color-highlight);
	}

	/*
	 * Each line of the title stays whole and takes the width of the column: in
	 * WebKit, a title sized to its content could wrap every line word by word.
	 */
	.hero__title {
		width: 100%;
		font-size: clamp(var(--text-4xl), 4.4vw, var(--text-5xl));
		line-height: 1.12;
	}
	.hero__line {
		display: block;
		white-space: nowrap;
	}
	/* The last line, what you do with it, is marked as with a highlighter. */
	.hero__line--last {
		display: inline-block;
		background: linear-gradient(transparent 60%, var(--color-accent-soft) 60%);
	}
	/* Each word rises out of its own line. */
	.word {
		display: inline-block;
		overflow: hidden;
		vertical-align: top;
		padding-bottom: 0.1em;
		margin-bottom: -0.1em;
	}
	.word > span {
		display: inline-block;
	}

	.hero__lead {
		max-width: 34rem;
		margin: 0;
		color: var(--color-text-muted);
		font-size: var(--text-lg);
		line-height: var(--leading-lg);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		padding-top: var(--space-2);
	}
	.hero__actions .c-btn {
		height: 48px;
		padding-inline: var(--space-5);
		font-size: var(--text-base);
	}
	/* What the first button costs, and the way in for its members, right under it. */
	.hero__under {
		display: grid;
		gap: var(--space-1);
		margin-top: calc(-1 * var(--space-3));
		font-size: var(--text-sm);
		line-height: var(--leading-sm);
	}
	.hero__under p {
		margin: 0;
	}
	.hero__free {
		color: var(--color-text-muted);
	}
	.hero__member a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		font-weight: var(--weight-semibold);
		text-decoration: none;
	}
	.hero__member a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* The AIs that publish to a Cahut, under the buttons, each with its plans. */
	.hero__ais {
		display: grid;
		justify-self: stretch;
		gap: var(--space-3);
		padding-top: var(--space-5);
		border-top: var(--border-width) solid var(--color-border);
	}
	.hero__ais .c-label {
		margin: 0;
		color: var(--color-text-muted);
	}
	.hero__ai-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.hero__ai-list li {
		display: grid;
		align-content: start;
		font-size: var(--text-xs);
		line-height: var(--leading-xs);
		color: var(--color-text-muted);
	}
	.hero__ai-list li + li {
		padding-left: var(--space-4);
		border-left: var(--border-width) solid var(--color-border);
	}
	.hero__ai-list strong {
		color: var(--color-text);
		font-size: var(--text-xl);
		line-height: var(--leading-xl);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-title);
	}
	.hero__ai-more {
		display: inline-flex;
		align-items: center;
		justify-self: start;
		gap: var(--space-1);
		font-size: var(--text-sm);
		line-height: var(--leading-sm);
		font-weight: var(--weight-semibold);
		text-decoration: none;
	}
	.hero__ai-more:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* The scene: a browser, the AI that publishes into it, and the access of the Window. */
	.stage {
		position: relative;
		min-height: 640px;
	}
	.stage__browser,
	.stage__chat,
	.stage__share {
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--shadow-lg);
	}
	.stage__browser {
		position: absolute;
		top: 0;
		right: 0;
		width: 88%;
		overflow: hidden;
	}
	.stage__chat {
		position: absolute;
		top: 190px;
		left: 0;
		z-index: 2;
		width: 52%;
	}
	.stage__share {
		position: absolute;
		top: 400px;
		right: var(--space-4);
		z-index: 3;
		width: 58%;
		padding: var(--space-4);
	}

	.stage__bar {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-3);
		border-bottom: var(--border-width) solid var(--color-border);
		background: var(--color-surface-muted);
	}
	.stage__dots {
		display: flex;
		gap: 6px;
	}
	.stage__dots i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--color-border-strong);
	}
	.stage__address {
		display: flex;
		flex: 1;
		align-items: center;
		gap: var(--space-2);
		min-width: 0;
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-pill);
		background: var(--color-surface);
		color: var(--color-text-muted);
		font-size: var(--text-xs);
		line-height: var(--leading-xs);
		white-space: nowrap;
	}
	.stage__address .c-mono {
		overflow: hidden;
		text-overflow: ellipsis;
		min-height: 1em;
	}
	.stage__view {
		position: relative;
		aspect-ratio: 16 / 10;
		background: var(--color-surface-muted);
		overflow: hidden;
	}
	/* A page waiting for its content, before the Window arrives. */
	.stage__skeleton {
		position: absolute;
		inset: 0;
		opacity: 0.7;
		background:
			linear-gradient(var(--color-border) 0 0) 8% 14% / 40% 8% no-repeat,
			linear-gradient(var(--color-border) 0 0) 8% 30% / 60% 4% no-repeat,
			linear-gradient(var(--color-border) 0 0) 8% 38% / 52% 4% no-repeat,
			linear-gradient(var(--color-border) 0 0) 8% 70% / 26% 18% no-repeat,
			linear-gradient(var(--color-border) 0 0) 38% 70% / 26% 18% no-repeat,
			linear-gradient(var(--color-border) 0 0) 68% 70% / 26% 18% no-repeat;
	}
	.stage__view img {
		position: absolute;
		inset: 0;
		z-index: 1;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		clip-path: inset(0 0 100% 0);
		transition: clip-path 900ms var(--ease-out);
	}
	.stage__view img.is-shown {
		clip-path: inset(0 0 0 0);
	}

	.stage__head {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin: 0;
		padding: var(--space-3) var(--space-4);
		border-bottom: var(--border-width) solid var(--color-border);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
	}
	.stage__ai {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-accent);
	}
	.stage__clients {
		margin-left: auto;
		color: var(--color-text-muted);
		font-size: var(--text-xs);
		font-weight: var(--weight-regular);
	}
	.stage__messages {
		display: grid;
		align-content: start;
		gap: var(--space-3);
		min-height: 196px;
		padding: var(--space-4);
	}
	.bubble {
		max-width: 92%;
		margin: 0;
		padding: var(--space-3) var(--space-4);
		border-radius: var(--radius-lg);
		font-size: var(--text-sm);
		line-height: var(--leading-sm);
	}
	.bubble p {
		margin: 0;
	}
	.bubble--you {
		justify-self: end;
		min-height: 2.6em;
		border-bottom-right-radius: var(--radius-xs);
		background: var(--color-primary);
		color: var(--color-on-primary);
	}
	.bubble--you:empty:not(.is-typing) {
		visibility: hidden;
	}
	.bubble--you.is-typing::after {
		content: '';
		display: inline-block;
		width: 2px;
		height: 1em;
		margin-left: 2px;
		vertical-align: -2px;
		background: currentColor;
		animation: caret 1s steps(1) infinite;
	}
	.bubble--ai {
		justify-self: start;
		border-bottom-left-radius: var(--radius-xs);
		background: var(--color-surface-muted);
	}
	.bubble__busy {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--color-text-muted);
	}
	.spinner {
		flex: none;
		width: 14px;
		height: 14px;
		border: 2px solid var(--color-border-strong);
		border-top-color: var(--color-text);
		border-radius: 50%;
		animation: spin 800ms linear infinite;
	}
	.bubble__url {
		color: var(--color-link);
		font-size: var(--text-xs);
		word-break: break-all;
	}
	[hidden] {
		display: none !important;
	}

	.stage__share .c-label {
		margin: 0 0 var(--space-2);
	}
	.stage__access {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* The access of the Window: the current one stands out, the others wait. */
	.stage__access li {
		opacity: 0.4;
		transition: opacity var(--duration-slow) var(--ease-out);
	}
	.stage__access li.is-on {
		opacity: 1;
		box-shadow: var(--ring);
	}
	.stage__knock {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: var(--space-3);
		margin-top: var(--space-3);
		padding: var(--space-3);
		border: var(--border-width) solid var(--color-warning-border);
		border-left-width: 4px;
		border-radius: var(--radius-md);
		background: var(--color-highlight-soft);
	}
	.stage__knock p {
		margin: 0;
		font-size: var(--text-xs);
		line-height: var(--leading-xs);
	}
	.stage__picto :global(svg) {
		display: block;
		width: 32px;
		height: 32px;
	}
	.stage__approve {
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-sm);
		background: var(--color-primary);
		color: var(--color-on-primary);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		white-space: nowrap;
		transition:
			scale var(--duration-fast),
			background var(--duration-base);
	}
	.stage__approve.is-pressed {
		scale: 0.94;
	}
	.stage__approve.is-done {
		background: var(--color-success);
		color: var(--color-success-bg);
	}

	.stage__controls {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}
	.stage__steps {
		display: flex;
		gap: var(--space-2);
	}
	.stage__steps button {
		width: 28px;
		height: 6px;
		padding: 0;
		border: 0;
		border-radius: var(--radius-pill);
		background: var(--color-border-strong);
		cursor: pointer;
	}
	.stage__steps button[aria-current='true'] {
		background: var(--color-text);
	}
	.stage__more {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		margin-left: auto;
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		text-decoration: none;
	}
	.stage__more:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .hero__sky {
			opacity: 0.05;
		}
	}
	:global(:root[data-theme='dark']) .hero__sky {
		opacity: 0.05;
	}

	/*
	 * The motion. Everything above is the page at rest, as it shows without
	 * scripts or with reduced motion.
	 */
	@media (prefers-reduced-motion: no-preference) {
		.hero__sky {
			animation: drift 90s linear infinite;
		}
		.hero__pulse::after {
			content: '';
			position: absolute;
			inset: 0;
			border-radius: 50%;
			background: var(--color-highlight);
			animation: pulse 2.4s var(--ease-out) infinite;
		}

		:global(.js) .word > span {
			translate: 0 110%;
			animation: rise 900ms var(--ease-out) calc(150ms + var(--i) * 70ms) forwards;
		}
		:global(.js) .hero__status,
		:global(.js) .hero__lead,
		:global(.js) .hero__actions,
		:global(.js) .hero__under,
		:global(.js) .hero__ais {
			opacity: 0;
			animation: appear 800ms var(--ease-out) forwards;
		}
		:global(.js) .hero__status {
			animation-delay: 50ms;
		}
		:global(.js) .hero__lead {
			animation-delay: 650ms;
		}
		:global(.js) .hero__actions {
			animation-delay: 800ms;
