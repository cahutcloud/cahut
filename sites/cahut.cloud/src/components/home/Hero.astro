</style>

<script>
	// The scene plays the demos one after the other: the request is typed, the
	// AI publishes the Window, then knocks to make it public and a person
	// approves. With reduced motion, each demo shows at once, at its end.
	type Scene = { prompt: string; url: string; room: string; image: string };

	document.querySelectorAll<HTMLElement>('[data-stage]').forEach((stage) => {
		const scenes: Scene[] = JSON.parse(stage.dataset.scenes ?? '[]');
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const get = <T extends HTMLElement>(name: string) => stage.querySelector<T>(`[data-scene-${name}]`)!;
		const prompt = get('prompt');
		const reply = get('reply');
		const busy = get('busy');
		const done = get('done');
		const room = get('room');
		const url = get('url');
		const address = get('address');
		const shot = get<HTMLImageElement>('shot');
		const knock = get('knock');
		const approve = get('approve-button');
		const accesses = [...stage.querySelectorAll<HTMLElement>('[data-scene-access]')];
		const steps = [...stage.querySelectorAll<HTMLButtonElement>('[data-scene-step]')];
		let run = 0;

		// The images load before their turn, so that the page never waits.
		scenes.forEach(({ image }) => {
			new Image().src = image;
		});

		const wait = (ms: number, id: number) =>
			new Promise<void>((resolve, reject) => setTimeout(() => (id === run ? resolve() : reject()), ms));
		const setAccess = (id: string) => accesses.forEach((item) => item.classList.toggle('is-on', item.dataset.sceneAccess === id));

		function reset(scene: Scene) {
			prompt.textContent = '';
			prompt.classList.remove('is-typing');
			reply.hidden = true;
			busy.hidden = false;
			done.hidden = true;
			room.textContent = scene.room;
			url.textContent = scene.url;
			address.textContent = '';
			shot.classList.remove('is-shown');
			shot.src = scene.image;
			knock.hidden = true;
			approve.textContent = stage.dataset.approve ?? '';
			approve.classList.remove('is-pressed', 'is-done');
			setAccess('room');
		}

		function end(scene: Scene) {
			reset(scene);
			prompt.textContent = scene.prompt;
			reply.hidden = false;
			busy.hidden = true;
			done.hidden = false;
			address.textContent = scene.url;
			shot.classList.add('is-shown');
			knock.hidden = false;
			approve.textContent = stage.dataset.approved ?? '';
			approve.classList.add('is-done');
			setAccess('public');
		}

		async function play(index: number) {
			const id = ++run;
			const scene = scenes[index];
			steps.forEach((step, n) => step.setAttribute('aria-current', String(n === index)));
			if (reduced) {
				end(scene);
				return;
			}
			try {
				reset(scene);
				await wait(500, id);
				// 1. The person asks.
				prompt.classList.add('is-typing');
				for (let k = 1; k <= scene.prompt.length; k++) {
					prompt.textContent = scene.prompt.slice(0, k);
					await wait(scene.prompt[k - 1] === ' ' ? 24 : 18, id);
				}
				prompt.classList.remove('is-typing');
				await wait(450, id);
				// 2. The AI publishes the Window.
				reply.hidden = false;
				await wait(1100, id);
				busy.hidden = true;
				done.hidden = false;
				for (let k = 1; k <= scene.url.length; k += 2) {
					address.textContent = scene.url.slice(0, k);
					await wait(14, id);
				}
				address.textContent = scene.url;
				shot.classList.add('is-shown');
				await wait(1900, id);
				// 3. Making it public knocks first, and a person approves.
				knock.hidden = false;
				await wait(1500, id);
				approve.classList.add('is-pressed');
				await wait(180, id);
				approve.classList.remove('is-pressed');
				approve.classList.add('is-done');
				approve.textContent = stage.dataset.approved ?? '';
				setAccess('public');
				await wait(2600, id);
				play((index + 1) % scenes.length);
			} catch {
				// A newer run took over.
			}
		}

		steps.forEach((step, index) => step.addEventListener('click', () => play(index)));
		if (scenes.length) play(0);
	});
</script>
