---
// The home page of cahut.cloud, in each language of the site: its words come
// from the dictionaries of src/i18n.
import Address from './Address.astro';
import Examples from './Examples.astro';
import Hero from './Hero.astro';
import KnockDemo from './KnockDemo.astro';
import Start from './Start.astro';
import Steps from './Steps.astro';
import Icon, { type IconName } from '../Icon.astro';
import Base from '../../layouts/Base.astro';
import { localize, useTranslations, type Lang } from '../../i18n';
import cahutPicto from '@charte/icones/cahut.svg?raw';
import houseStylePicto from '@charte/icones/house-style.svg?raw';
import keyPicto from '@charte/icones/key.svg?raw';
import knockFirstPicto from '@charte/icones/knock-first.svg?raw';
import logbookPicto from '@charte/icones/logbook.svg?raw';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// The icons and pictograms go with the words, in the order of the dictionaries.
const layers = t.statement.layers.map((layer, index) => ({ ...layer, home: index === 1 }));

const featureIcons: IconName[][] = [
	['file-text', 'box', 'history', 'search', 'file-down'],
	['plug', 'palette'],
	['link', 'mail', 'message-square', 'users', 'log-in'],
	['terminal', 'monitor-cog', 'globe', 'gauge', 'scroll-text', 'hard-drive-upload', 'refresh-cw'],
];
const featureGroups = t.features.groups.map((group, index) => ({
	...group,
	id: ['publish', 'connect', 'share', 'run'][index],
	features: group.features.map((feature, item) => ({ ...feature, icon: featureIcons[index][item] })),
}));

const principleIcons: IconName[] = ['box', 'undo-2', 'file-text', 'key-round', 'scroll-text', 'server', 'shield-check'];
const principles = t.knock.principles.map((principle, index) => ({ ...principle, icon: principleIcons[index] }));

const wordPictos = [keyPicto, houseStylePicto, knockFirstPicto, logbookPicto];
const words = t.vocabulary.words.map((word, index) => ({ ...word, picto: wordPictos[index] }));

const accessBadges = [
	{ badge: 'room', icon: 'lock', label: t.vocabulary.accessLabels.room },
	{ badge: 'internal', icon: 'users', label: t.vocabulary.accessLabels.internal },
	{ badge: 'key', icon: 'key-round', label: t.vocabulary.accessLabels.key },
	{ badge: 'public', icon: 'globe', label: t.vocabulary.accessLabels.public },
] as const;
const access = accessBadges.map((item, index) => ({ ...item, text: t.vocabulary.access[index] }));

// The step under way, in the order of the roadmap: the road to the public
// launch, since the first version met the success criteria on a fresh server.
const currentStep = 4;
const roadmap = t.roadmap.steps.map((step, index) => ({ step, current: index === currentStep }));
---

<Base
	title={t.meta.title}
	description={t.meta.description}
	lang={lang}
	alternates={{ en: localize('en'), fr: localize('fr') }}
	fullWidth
>
	<Hero lang={lang} />
	<Steps lang={lang} />
	<Examples lang={lang} />

	<section class="statement" data-theme="dark" aria-labelledby="statement-title">
		<div class="container statement__grid">
			<div class="statement__text" data-reveal>
				<p class="c-label">{t.statement.label}</p>
				<h2 id="statement-title" class="c-h1">{t.statement.title}</h2>
				<p class="lead">{t.statement.lead}</p>
				<p class="c-muted">{t.statement.text}</p>
			</div>
			<ol class="layers" role="list" data-reveal-group>
				{
					layers.map(({ layer, who, what, tags, home }) => (
						<li class:list={['layer', { 'layer--home': home }]} data-reveal>
							<div class="layer__head">
								<div>
									<p class="c-label">{layer}</p>
									<h3 class="c-h4">{who}</h3>
								</div>
								{home && <span class="layer__picto" aria-hidden="true" set:html={cahutPicto} />}
							</div>
							<p class="c-muted c-small">{what}</p>
							<ul class="layer__tags" role="list">
								{tags.map((tag) => (
									<li>{tag}</li>
								))}
							</ul>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section id="knock-first" class="section section--muted" aria-labelledby="knock-title">
		<div class="container">
			<div class="knock-first">
				<div class="knock-first__text">
					<header class="section__head" data-reveal>
						<p class="c-label">{t.knock.label}</p>
						<h2 id="knock-title" class="c-h1">{t.knock.title}</h2>
						<p class="lead">{t.knock.lead}</p>
					</header>
					<div class="rules" data-reveal-group>
						<div class="rule" data-reveal>
							<p class="rule__title">
								<span class="rule__icon"><Icon name="check" size={16} /></span>
								<span>
									<span class="c-label">{t.knock.reversible}</span>
									<span class="c-h4">{t.knock.alone}</span>
								</span>
							</p>
							<ul>
								{t.knock.aloneItems.map((item) => <li>{item}</li>)}
							</ul>
						</div>
						<div class="rule rule--knock" data-reveal>
							<p class="rule__title">
								<span class="rule__icon"><Icon name="bell" size={16} /></span>
								<span>
									<span class="c-label">{t.knock.irreversible}</span>
									<span class="c-h4">{t.knock.approves}</span>
								</span>
							</p>
							<ul>
								{t.knock.approvedItems.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					</div>
				</div>
				<div class="knock-first__demo" data-reveal>
					<p class="c-small c-muted try"><Icon name="mouse-pointer" size={16} />{t.knock.try}</p>
					<KnockDemo lang={lang} />
				</div>
			</div>

			<h3 class="c-h3 subhead" data-reveal>{t.knock.principlesTitle}</h3>
			<ol class="principles" role="list" data-reveal-group>
				{
					principles.map(({ title, text, icon }, index) => (
						<li class="principle" data-reveal>
							<span class="principle__top">
								<span class="principle__icon">
									<Icon name={icon} size={20} />
								</span>
								<span class="c-mono principle__num">{String(index + 1).padStart(2, '0')}</span>
							</span>
							<h4 class="c-h4">{title}</h4>
							<p class="c-muted c-small">{text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section id="features" class="section container" aria-labelledby="features-title">
		<header class="section__head" data-reveal>
			<p class="c-label">{t.features.label}</p>
			<h2 id="features-title" class="c-h1">{t.features.title}</h2>
			<p class="lead">{t.features.lead}</p>
		</header>
		<div class="feature-groups">
			{
				featureGroups.map(({ id, title, text, features }) => (
					<section class="feature-group" aria-labelledby={`features-${id}`} data-reveal>
						<header class="feature-group__head">
							<h3 id={`features-${id}`} class="c-h3">
								{title}
							</h3>
							<p class="c-muted c-small">{text}</p>
						</header>
						<dl class="features">
							{features.map(({ area, text, icon }) => (
								<div class="feature">
									<dt>
										<span class="feature__icon">
											<Icon name={icon} size={20} />
										</span>
										<span class="feature__title">{area}</span>
									</dt>
									<dd class="c-muted c-small">{text}</dd>
								</div>
							))}
						</dl>
					</section>
				))
			}
		</div>
		<div class="not-done" data-reveal>
			<h3 class="c-h3">{t.features.notDoneTitle}</h3>
			<ul role="list">
				{
					t.features.notDone.map((item) => (
						<li>
							<Icon name="x" size={16} />
							<span>{item}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section id="vocabulary" class="section section--muted" aria-labelledby="vocabulary-title">
		<div class="container">
			<header class="section__head" data-reveal>
				<p class="c-label">{t.vocabulary.label}</p>
				<h2 id="vocabulary-title" class="c-h1">{t.vocabulary.title}</h2>
				<p class="lead">{t.vocabulary.lead}</p>
			</header>
			<div data-reveal>
				<Address lang={lang} />
			</div>
			<ul class="words" role="list" data-reveal-group>
				{
					words.map(({ word, picto, meaning }) => (
						<li class="word" data-reveal>
							<span class="picto" aria-hidden="true" set:html={picto} />
							<h3 class="c-h4">{word}</h3>
							<p class="c-muted c-small">{meaning}</p>
						</li>
					))
				}
			</ul>
			<div class="access" data-reveal>
				<div class="access__text">
					<h3 class="c-h4">{t.vocabulary.accessTitle}</h3>
					<p class="c-muted c-small">{t.vocabulary.accessText}</p>
				</div>
				<ul class="access__list" role="list">
					{
						access.map(({ badge, icon, label, text }) => (
							<li>
								<span class={`c-badge c-badge--${badge}`}>
									<Icon name={icon} size={14} />
									{label}
								</span>
								<span class="c-small c-muted">{text}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<section id="roadmap" class="section container" aria-labelledby="roadmap-title">
		<header class="section__head" data-reveal>
			<p class="c-label">{t.roadmap.label}</p>
			<h2 id="roadmap-title" class="c-h1">{t.roadmap.title}</h2>
			<p class="lead">{t.roadmap.lead}</p>
			<a class="more" href={localize(lang, '/project/roadmap/')}>
				{t.roadmap.more}
				<Icon name="arrow-right" size={16} />
			</a>
		</header>
		<div class="roadmap">
			<ol
				class="milestones"
				role="list"
				style={`--progress: ${(currentStep / (roadmap.length - 1)) * 100}%`}
				data-reveal="fade"
			>
				{
					roadmap.map(({ step, current }, index) => (
						<li
							class:list={['milestone', { 'is-past': index < currentStep }]}
							aria-current={current ? 'step' : undefined}
						>
							<span class="milestone__dot c-mono" aria-hidden="true">
								{index + 1}
							</span>
							<div class="milestone__text">
								<p>{step}</p>
								{current && (
									<p class="c-badge c-badge--neutral">
										<span class="c-dot" />
										{t.roadmap.underWay}
									</p>
								)}
							</div>
						</li>
					))
				}
			</ol>
			<div class="criteria" data-reveal>
				<h3 class="c-h3">{t.roadmap.criteriaTitle}</h3>
				<table>
					<thead>
						<tr>
							<th scope="col">{t.roadmap.criterion}</th>
							<th scope="col">{t.roadmap.threshold}</th>
						</tr>
					</thead>
					<tbody>
						{
							t.roadmap.criteria.map(({ criterion, threshold }) => (
								<tr>
									<th scope="row">{criterion}</th>
									<td>{threshold}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<Start lang={lang} />
</Base>

<style>
	.lead {
		font-size: var(--text-lg);
		line-height: var(--leading-lg);
	}
	p {
		margin: 0;
	}
	ul,
	ol,
	dl,
	dd,
	figure {
		margin: 0;
	}
	ul[role='list'],
	ol[role='list'] {
		padding: 0;
		list-style: none;
	}


	/* Sections */
	.section {
		padding-block: var(--space-24);
	}
	.section--muted {
		background: var(--color-surface-muted);
	}
	.section__head {
		display: grid;
		gap: var(--space-4);
		max-width: var(--measure);
		margin-bottom: var(--space-12);
	}
	.subhead {
		margin: var(--space-20) 0 var(--space-8);
	}

	.more {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		flex: none;
		font-size: var(--text-sm);
		line-height: var(--leading-sm);
		font-weight: var(--weight-semibold);
		text-decoration: none;
	}
	.more:hover {
		text-decoration: underline;
	}
	.more :global(.i) {
		transition: translate var(--duration-base) var(--ease-out);
	}
	.more:hover :global(.i) {
		translate: 3px 0;
	}
	.section__head .more {
		justify-self: start;
	}

	.feature__icon,
	.principle__icon {
		display: grid;
		place-items: center;
		width: var(--space-10);
		height: var(--space-10);
		border-radius: var(--radius-md);
		background: var(--color-surface-muted);
		color: var(--color-text);
	}
	/* Statement */
	.statement {
		padding-block: var(--space-24);
		background: var(--color-surface);
		color: var(--color-text);
	}
	.statement__grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		align-items: center;
		gap: var(--space-16);
	}
	.statement__text {
		display: grid;
		gap: var(--space-4);
	}
	.layers {
		--line: var(--space-8);
		position: relative;
		display: grid;
		gap: var(--space-4);
	}
	/* The work flows down through the layers. */
	.layers::before {
		content: '';
		position: absolute;
		top: var(--space-6);
		bottom: var(--space-6);
		left: calc(var(--line) - 1px);
		border-left: 2px dashed var(--color-border-strong);
	}
	.layer {
		position: relative;
		display: grid;
		gap: var(--space-3);
		margin-left: var(--space-16);
		padding: var(--space-5) var(--space-6);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface-muted);
	}
	.layer::before {
		content: '';
		position: absolute;
		top: var(--space-8);
		left: calc(-1 * var(--space-8) - 5px);
		width: var(--space-2);
		height: var(--space-2);
		border: 2px solid var(--color-border-strong);
		border-radius: 50%;
		background: var(--color-surface);
	}
	.layer--home {
		border-color: var(--color-accent);
		background: var(--color-bg);
		box-shadow: var(--shadow-lg);
	}
	.layer--home::before {
		border-color: var(--color-accent);
		background: var(--color-accent);
	}
	.layer__head {
		display: flex;
		align-items: start;
		justify-content: space-between;
		gap: var(--space-4);
	}
	.layer__head > div {
		display: grid;
		gap: var(--space-1);
	}
	.layer__picto {
		display: block;
		flex: none;
		width: var(--space-12);
		height: var(--space-12);
		color: var(--color-text);
	}
	.layer__picto :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
		color: inherit;
	}
	.layer__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.layer__tags li {
		padding: 2px var(--space-2);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-pill);
		color: var(--color-text-muted);
		font-size: var(--text-xs);
		line-height: var(--leading-xs);
		font-weight: var(--weight-semibold);
	}
	.layer--home .layer__tags li {
		border-color: var(--color-border-strong);
		color: var(--color-text);
	}

	/* Knock first */
	.knock-first {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: start;
		gap: var(--space-16);
	}
	.knock-first__text .section__head {
		margin-bottom: var(--space-8);
	}
	.rules {
		display: grid;
		gap: var(--space-4);
	}
	.rule {
		display: grid;
		gap: var(--space-4);
		padding: var(--space-6);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
	}
	.rule__title {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}
	.rule__title > span:last-child {
		display: grid;
	}
	.rule__icon {
		display: grid;
		place-items: center;
		flex: none;
		width: var(--space-8);
		height: var(--space-8);
		border-radius: 50%;
		background: var(--color-success-bg);
		color: var(--color-success);
	}
	.rule--knock .rule__icon {
		background: var(--color-highlight);
		color: var(--cahut-ink-900);
	}
	.rule ul {
		display: grid;
		gap: var(--space-2);
		padding-left: var(--space-5);
		font-size: var(--text-sm);
		line-height: var(--leading-sm);
	}
	.knock-first__demo {
		display: grid;
		gap: var(--space-3);
		position: sticky;
		top: calc(var(--header-height) + var(--space-6));
	}
	.try {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
	}

	.principles {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-4);
	}
	.principle {
		display: grid;
		align-content: start;
		gap: var(--space-2);
		padding: var(--space-6);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
	}
	.principle:last-child {
		grid-column: span 2;
	}
	.principle__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: var(--space-2);
	}
	.principle__num {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	/* Features */
	.feature-groups {
		columns: 2;
		column-gap: var(--space-6);
		margin-bottom: var(--space-12);
	}
	.feature-group {
		display: grid;
		gap: var(--space-2);
		margin-bottom: var(--space-6);
		padding: var(--space-6) var(--space-6) var(--space-3);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		break-inside: avoid;
	}
	.feature-group__head {
		display: grid;
		gap: var(--space-1);
		padding-bottom: var(--space-4);
		border-bottom: var(--border-width) solid var(--color-border);
	}
	.features {
		display: grid;
	}
	.feature {
		display: grid;
		gap: var(--space-1);
		padding-block: var(--space-4);
	}
	.feature + .feature {
		border-top: var(--border-width) solid var(--color-border);
	}
	.feature dt {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}
	.feature dd {
		padding-left: calc(var(--space-10) + var(--space-4));
	}
	.feature__icon {
		flex: none;
		transition:
			background var(--duration-slow) var(--ease-out),
			color var(--duration-slow) var(--ease-out);
	}
	.feature:hover .feature__icon {
		background: var(--color-primary);
		color: var(--color-on-primary);
	}
	.feature__title {
		font-weight: var(--weight-semibold);
	}
	.not-done {
		display: grid;
		gap: var(--space-5);
		padding: var(--space-8);
		border: 2px dashed var(--color-border-strong);
		border-radius: var(--radius-xl);
	}
	.not-done ul {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: var(--space-3) var(--space-8);
	}
	.not-done li {
		display: flex;
		align-items: start;
		gap: var(--space-3);
	}
	.not-done li :global(.i) {
		flex: none;
		margin-top: var(--space-1);
		color: var(--color-text-muted);
	}

	/* Vocabulary */
	.words {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-4);
		margin-top: var(--space-12);
	}
	.word {
		display: grid;
		align-content: start;
		gap: var(--space-2);
		padding: var(--space-6);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
	}
	.picto {
		display: block;
		width: var(--space-12);
		height: var(--space-12);
		margin-bottom: var(--space-2);
		color: var(--color-text);
		transition: translate var(--duration-slow) var(--ease-out);
	}
	/* The pictograms set their stroke color on their root: follow the text instead. */
	.picto :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
		color: inherit;
	}
	.word:hover .picto {
		translate: 0 calc(-1 * var(--space-1));
	}
	.access {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
		align-items: center;
		gap: var(--space-8);
