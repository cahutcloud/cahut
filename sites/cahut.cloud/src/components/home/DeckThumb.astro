---
// A slide of the Q3 review, the Window that the pages of the site follow from
// the AI to its readers. It is drawn with the brand's raw colors: a Window
// keeps the house style it was made in, whatever the theme of the reader.
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['deck', className]} viewBox="0 0 160 100" aria-hidden="true" focusable="false">
	<rect class="deck__bg" width="160" height="100" />
	<rect class="deck__ink" x="12" y="12" width="64" height="7" rx="3.5" />
	<rect class="deck__muted" x="12" y="24" width="42" height="4" rx="2" />
	<circle class="deck__sun" cx="138" cy="20" r="7" />
	<g class="deck__bars">
		<rect class="deck__bar" x="12" y="64" width="12" height="24" rx="2" />
		<rect class="deck__bar" x="30" y="56" width="12" height="32" rx="2" />
		<rect class="deck__bar" x="48" y="60" width="12" height="28" rx="2" />
		<rect class="deck__bar" x="66" y="48" width="12" height="40" rx="2" />
		<rect class="deck__bar deck__bar--high" x="84" y="40" width="12" height="48" rx="2" />
	</g>
	<path class="deck__line" d="M18 58 36 50 54 54 72 42 90 32" />
	<rect class="deck__muted" x="108" y="44" width="40" height="4" rx="2" />
	<rect class="deck__muted" x="108" y="54" width="32" height="4" rx="2" />
	<rect class="deck__muted" x="108" y="64" width="36" height="4" rx="2" />
	<rect class="deck__muted" x="108" y="74" width="24" height="4" rx="2" />
</svg>

<style>
	.deck {
		display: block;
		width: 100%;
		height: auto;
	}
	.deck__bg {
		fill: var(--cahut-white);
	}
	.deck__ink {
		fill: var(--cahut-ink);
	}
	.deck__muted {
		fill: var(--cahut-ink-200);
	}
	.deck__sun {
		fill: var(--cahut-soft-yellow);
	}
	.deck__bar {
		fill: var(--cahut-sky-200);
		transform-box: fill-box;
		transform-origin: bottom;
	}
	.deck__bar--high {
		fill: var(--cahut-sky-400);
	}
	.deck__line {
		fill: none;
		stroke: var(--cahut-sky-600);
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>
