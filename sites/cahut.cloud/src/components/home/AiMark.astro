---
// The mark of an AI client, from the official file of its vendor, left as they
// give it: neither recolored nor redrawn. Its size is --mark, set by the list
// that holds it. The name beside it says which AI it is, so the mark itself
// stays out of the accessibility tree.
interface Props {
	id: 'claude' | 'mistral' | 'chatgpt';
	mark: string;
}

const { id, mark } = Astro.props;

// The file of Mistral holds its clear space around the icon: the gaps of the
// page keep it, and the icon takes the same room as the others.
const frames: Partial<Record<Props['id'], string>> = { mistral: '11 31 140 100' };

let svg = mark
	.replace(/ width="\d+" height="\d+"/, '')
	.replace('<svg', '<svg aria-hidden="true" focusable="false"');
const frame = frames[id];
if (frame) svg = svg.replace(/viewBox="[^"]*"/, `viewBox="${frame}"`);
---

<span class={`mark mark--${id}`} set:html={svg} />

<style>
	.mark {
		display: block;
		flex: none;
		width: var(--mark, 32px);
		height: var(--mark, 32px);
	}
	.mark :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* OpenAI gives the Blossom in black and in white: white in the dark. */
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .mark--chatgpt :global(path) {
			fill: #fff;
		}
	}
	:global(:root[data-theme='dark']) .mark--chatgpt :global(path) {
		fill: #fff;
	}
</style>
