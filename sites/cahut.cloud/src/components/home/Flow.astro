---
// How Cahut works, as a diagram that plays itself in five steps: an AI
// connects, publishes a Window, shares it, knocks before making it public,
// and every action goes to the Logbook. The steps play when the diagram comes
// into view; the visitor can pause them or pick one.
import DeckThumb from './DeckThumb.astro';
import Icon from '../Icon.astro';
import cahutPicto from '@charte/icones/cahut.svg?raw';

const steps = [
	{
		title: 'Connect',
		heading: 'Add Cahut to your AI, once.',
		text: 'Your AI connects to your Cahut over MCP, the open protocol that links AIs to tools. You authorize it with OAuth, with the scope you choose. No AI model runs on your server.',
		call: 'MCP · OAuth · on behalf of Olivier',
		duration: 6000,
	},
	{
		title: 'Publish',
		heading: 'Ask for a deck. The AI publishes a Window.',
		text: 'The AI calls one typed operation, never a shell. Cahut applies your house style, files the Window in its Room, and hands back its address.',
		call: 'publish_window(room: "marketing", window: "q3-review")',
		duration: 8500,
	},
	{
		title: 'Share',
		heading: 'Share a link, not a file.',
		text: 'Each Window opens to its Room only, to everyone in your Cahut, to anyone with its Key, or to the public. Readers open it in a browser and comment on it.',
		call: 'share_window(window: "q3-review", access: "key")',
		duration: 8500,
	},
	{
		title: 'Knock first',
		heading: 'What cannot be undone waits for you.',
		text: 'Making a Window public cannot be undone. So the AI knocks: the request waits in the console, with a notification and an expiry, until a person approves it.',
		call: 'share_window(access: "public") → waiting for Olivier',
		duration: 10000,
	},
	{
		title: 'Logbook',
		heading: 'Every action is in the Logbook.',
		text: 'Which AI, on whose behalf, what it did and with what result. The Logbook keeps every action, readable in the console.',
		call: 'logbook: 4 entries, 1 approved by a person',
		duration: 6500,
	},
];

const ais = [
	{ mark: 'Cl', name: 'Claude' },
	{ mark: 'GP', name: 'ChatGPT' },
	{ mark: 'Mi', name: 'Mistral' },
	{ mark: 'Co', name: 'Copilot' },
];

const operations = ['publish_window', 'share_window', 'get_window', 'list_windows'];

const log = [
	{ time: '09:12', text: 'connected for Olivier' },
	{ time: '09:14', text: 'published', window: 'Q3 review' },
	{ time: '09:20', text: 'gave', window: 'Q3 review', after: 'a Key' },
	{ time: '09:31', text: 'asked to make', window: 'Q3 review', after: 'public', knock: true },
];

const readers = [
	{ id: 'team', icon: 'users', who: 'Marketing team', short: 'Team' },
	{ id: 'client', icon: 'key-round', who: 'A client, with the Key', short: 'Key' },
	{ id: 'public', icon: 'globe', who: 'Anyone', short: 'Public' },
] as const;

// Without scripts, the diagram shows its last step, with everything done.
const done = [
	's-claude',
	'w-mcp',
	's-door',
	's-style',
	's-window',
	'w-team',
	'r-team',
	'is-key',
	'w-client',
	'r-client',
	's-comment',
	'has-knock',
	'is-approved',
	'is-public',
	'w-public',
	'r-public',
	'log-1',
	'log-2',
	'log-3',
	'log-4',
];
---

<div class="flow" data-flow role="group" aria-label="How Cahut works, in five steps">
	<div class="flow__bar">
		<ol class="flow__tabs" role="list">
			{
				steps.map(({ title, duration }, index) => (
					<li>
						<button
							type="button"
							class="flow__tab"
							data-flow-tab={index + 1}
							style={`--duration: ${duration}ms`}
							aria-label={`Step ${index + 1}: ${title}`}
						>
							<span class="flow__num">{index + 1}</span>
							<span class="flow__tab-title">{title}</span>
							<span class="flow__track" aria-hidden="true" />
						</button>
					</li>
				))
			}
		</ol>
		<button type="button" class="c-btn c-btn--secondary c-btn--sm flow__play" data-flow-play hidden>
			<span class="flow__pause-label"><Icon name="pause" size={14} />Pause</span>
			<span class="flow__play-label"><Icon name="play" size={14} />Play</span>
		</button>
	</div>

	<div class="flow__captions" data-flow-captions>
		{
			steps.map(({ heading, text, call }, index) => (
				<div class="flow__caption" data-flow-caption={index + 1}>
					<div class="flow__caption-text">
						<p class="c-label">Step {index + 1} of 5</p>
						<h3 class="c-h3">{heading}</h3>
						<p class="flow__caption-lead">{text}</p>
					</div>
					<code class="flow__call">
						<Icon name="terminal" size={14} />
						<span>{call}</span>
					</code>
				</div>
			))
		}
	</div>

	<div class:list={['flow__stage', done]} data-flow-stage aria-hidden="true">
		<svg class="flow__wires" data-flow-wires>
			{
				['mcp', 'team', 'client', 'public'].map((wire) => (
					<g class={`flow__wire flow__wire--${wire}`}>
						<path class="flow__wire-base" data-wire={wire} pathLength="1" />
						<path class="flow__wire-flow" data-wire-flow={wire} />
					</g>
				))
			}
		</svg>

		<div class="flow__col flow__ais">
			<p class="c-label flow__col-label">Your AIs</p>
			<ul class="flow__ai-list" role="list">
				{
					ais.map(({ mark, name }, index) => (
						<li class:list={['flow__ai', { 'flow__ai--active': index === 0 }]} data-anchor={index === 0 ? 'ai' : undefined}>
							<span class="c-ai__mark">{mark}</span>
							<span class="flow__ai-name">{name}</span>
							{index === 0 && <span class="flow__ai-status" />}
						</li>
					))
				}
			</ul>
			<p class="flow__note">They stay outside. No AI runs on your server.</p>
		</div>

		<div class="flow__col flow__server">
			<p class="c-label flow__col-label"><Icon name="server" size={14} />Your server</p>
			<div class="flow__machine">
				<div class="flow__cahut c-card">
					<span class="flow__door" data-anchor="door"><Icon name="plug" size={14} />MCP</span>
					<span class="flow__exit" data-anchor="exit"><Icon name="lock" size={14} />HTTPS</span>

					<div class="flow__cahut-head">
						<span class="flow__picto" set:html={cahutPicto} />
						<div>
							<p class="flow__cahut-name">Your Cahut</p>
							<p class="c-mono flow__domain">cahut.example.com</p>
						</div>
						<span class="flow__style"><Icon name="palette" size={14} />House style</span>
					</div>

					<div class="flow__ops">
						{
							operations.map((operation) => (
								<span class="flow__op c-mono" data-op={operation}>
									{operation}
								</span>
							))
						}
					</div>

					<div class="flow__body">
						<div class="flow__room">
							<p class="c-label">Room · marketing</p>
							<div class="flow__slot">
								<div class="flow__empty">No Windows yet</div>
								<div class="c-card c-window flow__window">
									<div class="flow__thumb"><DeckThumb /></div>
									<div class="c-window__body">
										<p class="c-window__title">Q3 review</p>
										<div class="c-window__meta">
											<span>marketing/q3-review</span>
											<span class="flow__access">
												<span class="c-badge c-badge--room">
													<Icon name="lock" size={14} />
													Room only
												</span>
												<span class="c-badge c-badge--key">
													<Icon name="key-round" size={14} />
													Key
												</span>
												<span class="c-badge c-badge--public">
													<Icon name="globe" size={14} />
													Public
												</span>
											</span>
										</div>
									</div>
								</div>
							</div>
						</div>

						<div class="flow__side">
							<div class="flow__knock-box">
								<p class="c-label">Knock first</p>
								<div class="flow__slot">
									<div class="flow__empty flow__empty--line">
										<Icon name="circle-check" size={14} />
										Nothing waits for you
									</div>
									<div class="c-card c-knock flow__knock">
										<div class="c-knock__head">
											<span class="c-ai">
												<span class="c-ai__mark">Cl</span>Claude
											</span>
											<span class="flow__knock-state">
												<span class="c-badge c-badge--warning">
													<span class="c-dot" />
													Waiting
												</span>
												<span class="c-badge c-badge--success">
													<Icon name="check" size={14} />
													Approved
												</span>
											</span>
										</div>
										<p class="flow__knock-text">
											Wants to make <b>Q3 review</b> public.
										</p>
										<div class="flow__knock-foot">
											<div class="c-knock__actions">
												<span class="c-btn c-btn--primary c-btn--sm flow__approve">
													<Icon name="check" size={14} />
													Approve
												</span>
												<span class="c-btn c-btn--secondary c-btn--sm">Decline</span>
												<span class="flow__cursor">
													<Icon name="mouse-pointer" size={20} />
												</span>
											</div>
											<p class="c-mono flow__knock-done">Approved by Olivier, 09:33</p>
										</div>
									</div>
								</div>
							</div>

							<div class="flow__log-box">
								<p class="c-label">Logbook</p>
								<ol class="flow__log" role="list">
									{
										log.map(({ time, text, window, after, knock }, index) => (
											<li class:list={['flow__log-row', `flow__log-row--${index + 1}`]}>
												<div>
													<span class="c-mono flow__log-time">{time}</span>
													<span class="flow__log-text">
														<span class="c-ai">
															<span class="c-ai__mark">Cl</span>Claude
														</span>{' '}
														{text}
														{window && (
															<>
																{' '}
																<b>{window}</b>
															</>
														)}
														{after && ` ${after}`}
													</span>
													<span class:list={['flow__log-result', { 'flow__log-result--knock': knock }]}>
														<Icon name="circle-check" size={14} />
														{knock && <Icon name="clock" size={14} />}
													</span>
												</div>
											</li>
										))
									}
								</ol>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="flow__col flow__readers">
			<p class="c-label flow__col-label">Your readers</p>
			<ul class="flow__reader-list" role="list">
				{
					readers.map(({ id, icon, who, short }) => (
						<li class:list={['flow__reader', `flow__reader--${id}`]} data-anchor={id}>
							<div class="flow__browser c-card">
								<p class="flow__browser-bar">
									<Icon name={icon} size={14} />
									<span class="flow__who">{who}</span>
									<span class="flow__who-short">{short}</span>
								</p>
								<div class="flow__screen">
									<div class="flow__closed">
										<Icon name="lock" size={16} />
										<span>Closed</span>
									</div>
									<div class="flow__open">
										<DeckThumb />
									</div>
									{id === 'client' && (
										<span class="flow__comment">
											<Icon name="message-square" size={14} />
											Looks good
										</span>
									)}
								</div>
							</div>
						</li>
					))
				}
			</ul>
		</div>

		<span class="flow__packet flow__packet--call" data-packet="publish">
			<Icon name="file-text" size={14} />publish_window
		</span>
		<span class="flow__packet flow__packet--back" data-packet="address">
			<Icon name="link" size={14} />marketing/q3-review
		</span>
		<span class="flow__packet flow__packet--call" data-packet="share">
			<Icon name="key-round" size={14} />share_window · Key
		</span>
		<span class="flow__packet flow__packet--back" data-packet="link-client">
			<Icon name="link" size={14} />Link and Key
		</span>
		<span class="flow__packet flow__packet--call" data-packet="public">
			<Icon name="globe" size={14} />share_window · Public
		</span>
		<span class="flow__packet flow__packet--back" data-packet="link-public">
			<Icon name="link" size={14} />Link
		</span>
	</div>
</div>

<script>
	// Plays the five steps of the diagram. Each step adds classes to the stage,
	// which the styles turn into motion; packets travel along the wires.

	class Cancelled extends Error {}

	type Step = (play: Play) => Promise<void>;

	interface Play {
		wait(ms: number): Promise<void>;
		fly(packet: string, wire: string, options?: { back?: boolean; duration?: number }): Promise<void>;
	}

	const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

	function setUp(root: HTMLElement) {
		const stage = root.querySelector<HTMLElement>('[data-flow-stage]')!;
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-flow-tab]')];
		const captions = [...root.querySelectorAll<HTMLElement>('[data-flow-caption]')];
		const captionBox = root.querySelector<HTMLElement>('[data-flow-captions]')!;
		const playButton = root.querySelector<HTMLButtonElement>('[data-flow-play]')!;
		const reduced = matchMedia('(prefers-reduced-motion: reduce)');

		const wires = new Map<string, SVGPathElement[]>();
		for (const path of stage.querySelectorAll<SVGPathElement>('[data-wire], [data-wire-flow]')) {
			const name = path.dataset.wire ?? path.dataset.wireFlow!;
			wires.set(name, [...(wires.get(name) ?? []), path]);
		}
		const anchor = (name: string) => stage.querySelector<HTMLElement>(`[data-anchor="${name}"]`)!;

		const durations = tabs.map((tab) => parseInt(tab.style.getPropertyValue('--duration'), 10));
		const flags = new Set([...stage.classList].filter((name) => /^(s|w|r|is|has|log|live|op|focus)-/.test(name)));
		const on = (...names: string[]) => names.forEach((name) => (flags.add(name), stage.classList.add(name)));
		const off = (...names: string[]) => names.forEach((name) => (flags.delete(name), stage.classList.remove(name)));

		let run = 0;
		let current = 0;
		let autoplay = !reduced.matches;
		let started = false;

		// The wires follow the layout: across on wide screens, down on narrow ones.
		function layout() {
			const box = stage.getBoundingClientRect();
			const across = getComputedStyle(stage).getPropertyValue('--axis').trim() !== 'down';
			const point = (element: HTMLElement, side: 'start' | 'end') => {
				const r = element.getBoundingClientRect();
				const x = r.left - box.left;
				const y = r.top - box.top;
				if (across) return { x: side === 'start' ? x + r.width : x, y: y + r.height / 2 };
				return { x: x + r.width / 2, y: side === 'start' ? y + r.height : y };
			};
			const curve = (a: { x: number; y: number }, b: { x: number; y: number }) => {
				if (across) {
					const d = (b.x - a.x) / 2;
					return `M${a.x} ${a.y}C${a.x + d} ${a.y} ${b.x - d} ${b.y} ${b.x} ${b.y}`;
				}
				const d = (b.y - a.y) / 2;
				return `M${a.x} ${a.y}C${a.x} ${a.y + d} ${b.x} ${b.y - d} ${b.x} ${b.y}`;
			};
			const set = (wire: string, d: string) => wires.get(wire)?.forEach((path) => path.setAttribute('d', d));
			set('mcp', curve(point(anchor('ai'), 'start'), point(anchor('door'), 'end')));
			const exit = point(anchor('exit'), 'start');
			for (const reader of ['team', 'client', 'public']) set(reader, curve(exit, point(anchor(reader), 'end')));
			const svg = stage.querySelector('svg')!;
			svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
		}

		function player(token: number, instant: boolean): Play {
			const check = () => {
				if (token !== run) throw new Cancelled();
			};
			return {
				wait(ms) {
					if (instant) return Promise.resolve();
					return new Promise((resolve, reject) =>
						setTimeout(() => (token === run ? resolve() : reject(new Cancelled())), ms),
					);
				},
				fly(name, wire, { back = false, duration = 1300 } = {}) {
					if (instant || reduced.matches) return Promise.resolve();
					const packet = stage.querySelector<HTMLElement>(`[data-packet="${name}"]`)!;
					const path = wires.get(wire)![0];
					return new Promise((resolve, reject) => {
						const start = performance.now();
						packet.classList.add('is-flying');
						const frame = (now: number) => {
							if (token !== run) {
								packet.classList.remove('is-flying');
								return reject(new Cancelled());
							}
							const t = Math.min(1, (now - start) / duration);
							const length = path.getTotalLength();
							const p = path.getPointAtLength(length * (back ? 1 - ease(t) : ease(t)));
							packet.style.transform = `translate(${p.x}px, ${p.y}px) translate(-50%, -50%)`;
							if (t < 1) return requestAnimationFrame(frame);
							packet.classList.remove('is-flying');
							check();
							resolve();
						};
						requestAnimationFrame(frame);
					});
				},
			};
		}

		const steps: Step[] = [
			async (p) => {
				on('s-claude');
				await p.wait(300);
				on('w-mcp');
				await p.wait(1000);
				on('s-door');
				await p.wait(400);
				on('log-1');
			},
			async (p) => {
				on('live-mcp');
				await p.fly('publish', 'mcp');
				off('live-mcp');
				on('op-publish_window', 's-style');
				await p.wait(600);
				on('s-window');
				await p.wait(700);
				off('op-publish_window');
				on('live-mcp');
				await p.fly('address', 'mcp', { back: true, duration: 1100 });
				off('live-mcp');
				on('log-2');
				await p.wait(500);
				on('w-team');
				await p.wait(800);
				on('r-team');
			},
			async (p) => {
				on('live-mcp');
				await p.fly('share', 'mcp');
				off('live-mcp');
				on('op-share_window', 'is-key');
				await p.wait(700);
				off('op-share_window');
				on('log-3', 'w-client');
				await p.wait(700);
				on('live-client');
				await p.fly('link-client', 'client', { duration: 1000 });
				off('live-client');
				on('r-client');
				await p.wait(900);
				on('s-comment');
			},
			async (p) => {
				on('live-mcp');
				await p.fly('public', 'mcp');
				off('live-mcp');
				on('op-share_window', 'has-knock', 's-knocking');
				await p.wait(500);
				off('op-share_window');
				on('log-4');
				await p.wait(1600);
				on('s-cursor');
				await p.wait(1000);
				on('s-press');
				await p.wait(300);
				off('s-knocking', 's-cursor', 's-press');
				on('is-approved');
				await p.wait(700);
				on('is-public', 'w-public');
				await p.wait(700);
				on('live-public');
				await p.fly('link-public', 'public', { duration: 1000 });
				off('live-public');
				on('r-public');
			},
			async () => {
				on('focus-log');
			},
		];

		function select(step: number, timed: boolean) {
			current = step;
			tabs.forEach((tab, index) => {
				const n = index + 1;
				tab.classList.toggle('is-done', n < step);
				tab.classList.toggle('is-current', n === step);
				tab.classList.toggle('is-timed', n === step && timed);
				if (n === step) tab.setAttribute('aria-current', 'step');
				else tab.removeAttribute('aria-current');
			});
			// Restart the bar of the current step.
			const bar = tabs[step - 1]?.querySelector<HTMLElement>('.flow__track');
			if (bar) {
				bar.style.animation = 'none';
				void bar.offsetWidth;
				bar.style.animation = '';
			}
			captions.forEach((caption, index) => caption.classList.toggle('is-current', index + 1 === step));
		}

		// Puts the stage, at once, in the state it has after the given step.
		async function rebuild(step: number) {
			stage.classList.add('is-instant');
			off(...flags);
			const p = player(run, true);
			for (let n = 1; n <= step; n++) await steps[n - 1](p);
			void stage.offsetWidth;
			stage.classList.remove('is-instant');
		}

		async function play(from: number) {
			const token = ++run;
			const p = player(token, false);
			await rebuild(from - 1);
			try {
				for (let n = from; n <= steps.length; n++) {
					select(n, autoplay);
					const start = performance.now();
					await steps[n - 1](p);
					if (!autoplay) return;
					await p.wait(Math.max(1500, durations[n - 1] - (performance.now() - start)));
				}
				// Back to the start: the stage empties, then plays again.
				off(...flags);
				select(1, false);
				await p.wait(1600);
				play(1);
			} catch (error) {
				if (!(error instanceof Cancelled)) throw error;
			}
		}

		// Shows a step as it ends, without motion.
		async function show(step: number) {
			run++;
			select(step, false);
			await rebuild(step);
		}

		function setAutoplay(value: boolean) {
			autoplay = value;
			root.classList.toggle('is-playing', value);
			playButton.setAttribute('aria-pressed', String(value));
		}

		tabs.forEach((tab, index) =>
			tab.addEventListener('click', () => {
				setAutoplay(false);
				// Read out the step that the visitor picked, not those that play by themselves.
				captionBox.setAttribute('aria-live', 'polite');
				if (reduced.matches) show(index + 1);
				else play(index + 1);
			}),
		);

		playButton.hidden = false;
		playButton.addEventListener('click', () => {
			if (autoplay) {
				setAutoplay(false);
				show(current);
			} else {
				setAutoplay(true);
				captionBox.setAttribute('aria-live', 'off');
				play(current >= steps.length ? 1 : current + 1);
			}
		});

		new ResizeObserver(layout).observe(stage);
		document.fonts?.ready.then(layout);
		layout();

		root.classList.add('is-ready');
		setAutoplay(autoplay);
		if (autoplay) {
			select(1, false);
			rebuild(0);
		} else {
			show(1);
		}

		// Plays only while the diagram is on screen.
		new IntersectionObserver(
			([entry]) => {
				if (!autoplay) return;
				if (entry.isIntersecting) {
					play(started ? current : 1);
					started = true;
				} else if (started) {
					show(current);
				}
			},
			{ threshold: 0.35 },
		).observe(stage);
	}

	document.querySelectorAll<HTMLElement>('[data-flow]').forEach(setUp);
</script>

