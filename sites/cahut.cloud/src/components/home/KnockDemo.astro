---
// A request that knocks first, as the console shows it. The visitor approves
// or declines it, and the answer goes to the Logbook.
import Icon from '../Icon.astro';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).demo;
const log = [
	{ time: '09:31', text: t.log[0], badge: 'warning', result: t.waiting },
	{ time: '09:20', text: t.log[1], badge: 'success', result: t.done },
	{ time: '09:14', text: t.log[2], badge: 'success', result: t.done },
];
const answers = { nothingWaits: t.nothingWaits, ...t.answers };
---

<div class="knock" data-knock data-answers={JSON.stringify(answers)}>
	<div class="knock__head">
		<span class="knock__bell"><Icon name="bell" size={16} /></span>
		<p><b>Knock first</b> <span class="c-muted">· {t.console}</span></p>
		<span class="c-badge c-badge--neutral knock__count" data-knock-count>{t.waitingCount}</span>
	</div>

	<div class="c-card c-knock knock__card" data-knock-card>
		<div class="c-knock__head">
			<span class="c-ai"><span class="c-ai__mark">Cl</span>Claude</span>
			<span class="c-badge c-badge--warning knock__state" data-knock-state><span class="c-dot"></span>{t.waiting}</span>
		</div>
		<p set:html={t.request} />
		<p class="c-mono c-muted knock__meta">{t.meta}</p>
		<div class="c-knock__actions knock__actions" data-knock-actions>
			<button type="button" class="c-btn c-btn--primary c-btn--sm" data-knock-answer="approve">
				<Icon name="check" size={14} />{t.approve}
			</button>
			<button type="button" class="c-btn c-btn--secondary c-btn--sm" data-knock-answer="decline">{t.decline}</button>
		</div>
		<p class="knock__result" data-knock-result role="status"></p>
	</div>

	<div class="knock__log">
		<p class="c-label">{t.logbook}</p>
		<ol class="c-log" role="list" data-knock-log>
			{
				log.map(({ time, text, badge, result }) => (
					<li class="c-log__row">
						<span class="c-log__time">{time}</span>
						<span>
							<span class="c-ai">
								<span class="c-ai__mark">Cl</span>Claude
							</span>{' '}
							<Fragment set:html={text} />
						</span>
						<span class={`c-badge c-badge--${badge}`}>{result}</span>
					</li>
				))
			}
		</ol>
	</div>

	<button type="button" class="c-btn c-btn--ghost c-btn--sm knock__again" data-knock-again hidden>
		<Icon name="undo-2" size={14} />{t.again}
	</button>
</div>

<script>
	interface Answer {
		badge: string;
		result: string;
		log: string;
		done: string;
	}

	document.querySelectorAll<HTMLElement>('[data-knock]').forEach((root) => {
		const card = root.querySelector<HTMLElement>('[data-knock-card]')!;
		const state = root.querySelector<HTMLElement>('[data-knock-state]')!;
		const count = root.querySelector<HTMLElement>('[data-knock-count]')!;
		const result = root.querySelector<HTMLElement>('[data-knock-result]')!;
		const log = root.querySelector<HTMLOListElement>('[data-knock-log]')!;
		const again = root.querySelector<HTMLButtonElement>('[data-knock-again]')!;
		const waiting = log.firstElementChild!.querySelector('.c-badge')!;
		const initial = { state: state.innerHTML, count: count.textContent, waiting: waiting.outerHTML };
		const words = JSON.parse(root.dataset.answers!) as { nothingWaits: string; approve: Answer; decline: Answer };

		// The words come from the dictionaries of the site, never from a visitor.
		const badge = (tone: string, text: string) => `<span class="c-badge c-badge--${tone}">${text}</span>`;

		root.querySelectorAll<HTMLButtonElement>('[data-knock-answer]').forEach((button) =>
			button.addEventListener('click', () => {
				const choice = button.dataset.knockAnswer as 'approve' | 'decline';
				const answer = words[choice];
				const tone = choice === 'approve' ? 'success' : 'danger';
				state.className = `c-badge c-badge--${tone} knock__state`;
				state.textContent = answer.badge;
				count.textContent = words.nothingWaits;
				root.classList.add('is-answered');
				card.classList.add(`is-${choice}`);
				result.textContent = answer.result;

				log.firstElementChild!.querySelector('.c-badge')!.outerHTML = badge(tone, answer.badge);
				const row = document.createElement('li');
				row.className = 'c-log__row knock__new';
				row.innerHTML = `<span class="c-log__time">09:33</span><span><span class="c-ai"><span class="c-ai__mark">OD</span>Olivier</span> ${answer.log}</span>${badge(tone, answer.done)}`;
				log.prepend(row);
				again.hidden = false;
				again.focus({ preventScroll: true });
			}),
		);

		again.addEventListener('click', () => {
			root.classList.remove('is-answered');
			card.classList.remove('is-approve', 'is-decline');
			state.className = 'c-badge c-badge--warning knock__state';
			state.innerHTML = initial.state;
			count.textContent = initial.count;
			result.textContent = '';
			log.querySelector('.knock__new')?.remove();
			log.firstElementChild!.querySelector('.c-badge')!.outerHTML = initial.waiting;
			again.hidden = true;
			root.querySelector<HTMLButtonElement>('[data-knock-answer="approve"]')!.focus({ preventScroll: true });
		});
	});
</script>

<style>
	.knock {
		display: grid;
		gap: var(--space-4);
		padding: var(--space-6);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-xl);
		background: var(--color-surface-muted);
	}
	.knock p {
		margin: 0;
	}
	.knock__head {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		font-size: var(--text-sm);
		line-height: var(--leading-sm);
	}
	.knock__bell {
		display: grid;
		place-items: center;
		width: var(--space-8);
		height: var(--space-8);
		border: var(--border-width) solid var(--color-border);
		border-radius: 50%;
		background: var(--color-surface);
		color: var(--color-text);
	}
	.knock__count {
		margin-left: auto;
	}
	.knock__card {
		padding: var(--space-5);
		box-shadow: var(--shadow-md);
		transition: border-color var(--duration-slow) var(--ease-out);
	}
	.knock__card.is-approve {
		border-left-color: var(--color-success);
	}
	.knock__card.is-decline {
		border-left-color: var(--color-border-strong);
	}
	.knock__state {
		margin-left: auto;
	}
	.knock__meta {
		font-size: var(--text-xs);
		line-height: var(--leading-xs);
	}
	.knock__actions .c-btn {
		height: 36px;
		padding-inline: var(--space-4);
		font-size: var(--text-sm);
	}
	.is-answered .knock__actions {
		display: none;
	}
	.knock__result {
		display: none;
		font-size: var(--text-sm);
		line-height: var(--leading-sm);
		font-weight: var(--weight-semibold);
	}
	.is-answered .knock__result {
		display: block;
	}
	.knock__log {
		display: grid;
		gap: var(--space-2);
		padding: var(--space-4) var(--space-5);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
	}
	.knock__log .c-log {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.knock__again {
		justify-self: start;
	}

	/* The bell rings now and then while the request waits. */
	@media (prefers-reduced-motion: no-preference) {
		.knock:not(.is-answered) .knock__bell :global(.i) {
			transform-origin: 50% 10%;
			animation: ring 4s var(--ease-out) 1s infinite;
		}
		.knock :global(.knock__new) {
			animation: arrive 600ms var(--ease-out);
		}
		.knock__result {
			animation: arrive 500ms var(--ease-out);
		}
	}
	@keyframes ring {
		0%,
		30%,
		100% {
			rotate: 0deg;
		}
		5%,
		15% {
			rotate: 14deg;
		}
		10%,
		20% {
			rotate: -12deg;
		}
	}
	@keyframes arrive {
		from {
			opacity: 0;
			translate: 0 calc(-1 * var(--space-2));
		}
	}

	@media (max-width: 640px) {
		.knock {
			padding: var(--space-4);
		}
		.knock__head .c-muted {
			display: none;
		}
		.knock__card {
			padding: var(--space-4);
		}
		.knock__log {
			padding: var(--space-3) var(--space-4);
		}
		.knock__log .c-log__row {
			grid-template-columns: 40px 1fr auto;
		}
	}
</style>
