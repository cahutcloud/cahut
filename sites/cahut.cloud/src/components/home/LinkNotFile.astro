---
// Six files and links for one deck, then one Window at one address. The scene
// switches by itself the first time it comes into view, and on demand.
import DeckThumb from './DeckThumb.astro';
import Icon from '../Icon.astro';

const files = [
	{ name: 'Q3 review v4 FINAL.pptx', meta: 'Attached, 8.2 MB', icon: 'file-text', x: 22, y: 20, r: -6 },
	{ name: 'Q3 review v5 (2).pptx', meta: 'Forwarded twice', icon: 'file-text', x: 70, y: 14, r: 4 },
	{ name: 'q3-notes.docx', meta: 'Converted back', icon: 'file-down', x: 80, y: 48, r: 7 },
	{ name: 'A chat link', meta: 'On one AI service', icon: 'link', x: 18, y: 56, r: 5 },
	{ name: 'Q3 numbers.xlsx', meta: 'Which version?', icon: 'layout-dashboard', x: 34, y: 86, r: -4 },
	{ name: 'A deck elsewhere', meta: 'On another service', icon: 'link', x: 72, y: 84, r: -7 },
] as const;
---

<div class="lnf" data-lnf data-mode="link">
	<div class="lnf__switch" role="group" aria-label="Compare">
		<span class="lnf__thumb" aria-hidden="true"></span>
		<button type="button" data-mode-button="files" aria-pressed="false">Today: files</button>
		<button type="button" data-mode-button="link" aria-pressed="true">With Cahut: a link</button>
	</div>

	<div class="lnf__stage">
		<ul class="lnf__files" role="list" aria-label="Today">
			{
				files.map(({ name, meta, icon, x, y, r }, index) => (
					<li class="lnf__file" style={`--x: ${x}%; --y: ${y}%; --r: ${r}deg; --i: ${index}`}>
						<Icon name={icon} size={16} />
						<span>
							<span class="lnf__name">{name}</span>
							<span class="lnf__meta">{meta}</span>
						</span>
					</li>
				))
			}
		</ul>

		<div class="lnf__window c-card" role="group" aria-label="With Cahut">
			<div class="lnf__bar">
				<Icon name="lock" size={14} />
				<span class="c-mono lnf__address">cahut.example.com/marketing/q3-review</span>
				<span class="c-badge c-badge--key"><Icon name="key-round" size={14} />Key</span>
			</div>
			<DeckThumb />
			<ul class="lnf__facts" role="list">
				<li><Icon name="refresh-cw" size={14} />Updated 2 minutes ago</li>
				<li><Icon name="history" size={14} />Version 2, the previous one kept</li>
				<li><Icon name="message-square" size={14} />3 comments</li>
			</ul>
		</div>
	</div>

	<p class="lnf__caption" aria-live="polite">
		<span class="lnf__caption--files">Six files and links for one deck. Which one is right, and who can see it?</span>
		<span class="lnf__caption--link">One address. The page updates, takes comments, keeps its versions, and exports to PDF or PowerPoint.</span>
	</p>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-lnf]').forEach((root) => {
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-mode-button]')];
		let touched = false;

		const set = (mode: string) => {
			root.dataset.mode = mode;
			buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.modeButton === mode)));
		};

		buttons.forEach((button) =>
			button.addEventListener('click', () => {
				touched = true;
				set(button.dataset.modeButton!);
			}),
		);

		// Start from the files, and turn them into a link once seen.
		set('files');
		root.classList.add('is-ready');
		const observer = new IntersectionObserver(
			([entry]) => {
				if (!entry.isIntersecting) return;
				observer.disconnect();
				setTimeout(() => touched || set('link'), 1600);
			},
			{ threshold: 0.6 },
		);
		observer.observe(root.querySelector('.lnf__stage')!);
	});
</script>

<style>
	.lnf {
		display: grid;
		gap: var(--space-5);
		justify-items: start;
	}

	/* The switch */
	.lnf__switch {
		position: relative;
		display: none;
		grid-template-columns: 1fr 1fr;
		padding: var(--space-1);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-pill);
		background: var(--color-surface);
		box-shadow: var(--shadow-sm);
	}
	:global(.js) .lnf__switch {
		display: grid;
	}
	.lnf__switch button {
		position: relative;
		z-index: 1;
		padding: var(--space-2) var(--space-4);
		border: 0;
		border-radius: var(--radius-pill);
		background: none;
		color: var(--color-text-muted);
		font: inherit;
		font-size: var(--text-sm);
		line-height: var(--leading-sm);
		font-weight: var(--weight-semibold);
		white-space: nowrap;
		cursor: pointer;
		transition: color var(--duration-slow) var(--ease-out);
	}
	.lnf__switch button[aria-pressed='true'] {
		color: var(--color-on-primary);
	}
	.lnf__thumb {
		position: absolute;
		top: var(--space-1);
		bottom: var(--space-1);
		left: var(--space-1);
		width: calc(50% - var(--space-1));
		border-radius: var(--radius-pill);
		background: var(--color-primary);
		transition: translate 500ms var(--ease-out);
	}
	[data-mode='link'] .lnf__thumb {
		translate: 100% 0;
	}

	/* The scene */
	.lnf__stage {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 3;
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-xl);
		background: var(--color-surface-muted);
		overflow: hidden;
	}
	.lnf__files {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.lnf__file {
		position: absolute;
		left: var(--x);
		top: var(--y);
		display: flex;
		align-items: center;
		gap: var(--space-2);
		width: max-content;
		max-width: 46%;
		padding: var(--space-2) var(--space-3);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		box-shadow: var(--shadow-md);
		translate: -50% -50%;
		rotate: var(--r);
		transition:
			left 900ms var(--ease-in-out),
			top 900ms var(--ease-in-out),
			rotate 900ms var(--ease-in-out),
			scale 900ms var(--ease-in-out),
			opacity 600ms var(--ease-out);
		transition-delay: calc(var(--i) * 60ms);
	}
	.lnf__file :global(.i) {
		flex: none;
		color: var(--color-text-muted);
	}
	.lnf__file > span {
		display: grid;
		min-width: 0;
	}
	.lnf__name {
		overflow: hidden;
		font-size: var(--text-sm);
		line-height: var(--leading-sm);
		font-weight: var(--weight-semibold);
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	.lnf__meta {
		color: var(--color-text-muted);
		font-size: var(--text-xs);
		line-height: var(--leading-xs);
	}
	/* The files gather into the Window and vanish. */
	[data-mode='link'] .lnf__file {
		left: 50%;
		top: 50%;
		rotate: 0deg;
		scale: 0.6;
		opacity: 0;
	}

	.lnf__window {
		position: absolute;
		left: 50%;
		top: 50%;
		width: min(78%, 26rem);
		overflow: hidden;
		box-shadow: var(--shadow-lg);
		translate: -50% -50%;
		opacity: 0;
		scale: 0.9;
		pointer-events: none;
		transition:
			opacity 700ms var(--ease-out),
			scale 700ms var(--ease-out);
	}
	[data-mode='link'] .lnf__window {
		opacity: 1;
		scale: 1;
		pointer-events: auto;
		transition-delay: 500ms;
	}
	.lnf__bar {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-3);
		border-bottom: var(--border-width) solid var(--color-border);
		font-size: var(--text-xs);
		line-height: var(--leading-xs);
	}
	.lnf__bar > :global(.i) {
		flex: none;
		color: var(--color-success);
	}
	.lnf__address {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	.lnf__window :global(.deck) {
		border-bottom: var(--border-width) solid var(--color-border);
	}
	.lnf__facts {
		display: grid;
		gap: var(--space-1);
		margin: 0;
		padding: var(--space-3);
		list-style: none;
		color: var(--color-text-muted);
		font-size: var(--text-xs);
		line-height: var(--leading-xs);
	}
	.lnf__facts li {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		opacity: 0;
		translate: 0 var(--space-1);
		transition:
			opacity 500ms var(--ease-out),
			translate 500ms var(--ease-out);
	}
	[data-mode='link'] .lnf__facts li {
		opacity: 1;
		translate: none;
	}
	[data-mode='link'] .lnf__facts li:nth-child(1) {
		transition-delay: 1000ms;
	}
	[data-mode='link'] .lnf__facts li:nth-child(2) {
		transition-delay: 1150ms;
	}
	[data-mode='link'] .lnf__facts li:nth-child(3) {
		transition-delay: 1300ms;
	}

	.lnf__caption {
		display: grid;
		max-width: 34rem;
		margin: 0;
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		line-height: var(--leading-sm);
	}
	.lnf__caption > span {
		grid-area: 1 / 1;
		transition: opacity var(--duration-slow) var(--ease-out);
	}
	[data-mode='files'] .lnf__caption--link,
	[data-mode='link'] .lnf__caption--files {
		opacity: 0;
		visibility: hidden;
	}

	@media (max-width: 640px) {
		.lnf__switch {
			width: 100%;
		}
		.lnf__switch button {
			padding-inline: var(--space-2);
			font-size: var(--text-xs);
		}
		.lnf__stage {
			aspect-ratio: 3 / 4;
		}
		.lnf__file {
			max-width: 62%;
			padding: var(--space-2);
		}
		[data-mode='files'] .lnf__file:nth-child(odd) {
			left: calc(var(--x) + 8%);
		}
		.lnf__window {
			width: 90%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.lnf :global(*) {
			transition-duration: 1ms !important;
			transition-delay: 0ms !important;
		}
	}
</style>
