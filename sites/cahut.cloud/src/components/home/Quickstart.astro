---
// The commands that take a server, or this machine, to a first Window, as
// the docs give them. Each step copies in one click; the last one types the
// request to the AI when the terminal comes into view.
import Icon from '../Icon.astro';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).quickstart;
const docs = 'https://docs.cahut.cloud';

const tabs = [
	{
		id: 'server',
		...t.tabs.server,
		address: 'https://cahut.example.com/you/project-summary/',
		steps: [
			{
				comment: t.comments.install,
				lines: [
					'curl -fsSLO https://raw.githubusercontent.com/getcahut/cahut/main/install.sh',
					'sudo sh install.sh --domain cahut.example.com',
				],
			},
			{
				comment: t.comments.account,
				lines: [
					'sudo -u cahut /usr/local/bin/cahut user create --handle you --name "Your Name" --admin',
					'sudo -u cahut /usr/local/bin/cahut token create --user you --name "Claude Code"',
				],
			},
			{
				comment: t.comments.connect,
				lines: [
					'claude mcp add --transport http cahut https://cahut.example.com/mcp --header "Authorization: Bearer <token>"',
				],
			},
		],
	},
	{
		id: 'local',
		...t.tabs.local,
		address: 'http://localhost:8080/you/project-summary/',
		steps: [
			{
				comment: t.comments.build,
				lines: ['git clone https://github.com/getcahut/cahut.git', 'cd cahut && make build'],
			},
			{
				comment: t.comments.declare,
				lines: [
					'bin/cahut domain add --data ./cahut-data localhost',
					'bin/cahut user create --data ./cahut-data --handle you --name "Your Name" --admin',
					'bin/cahut token create --data ./cahut-data --user you --name "Claude Code"',
				],
			},
			{ comment: t.comments.serve, lines: ['bin/cahut serve --dev --data ./cahut-data'] },
			{
				comment: t.comments.connectLocal,
				lines: [
					'claude mcp add --transport http cahut-dev http://localhost:8080/mcp --header "Authorization: Bearer <token>"',
				],
			},
		],
	},
];

// What the reader replaces in a command stands out from the rest.
const escape = (text: string) =>
	text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const highlight = (line: string) =>
	escape(line).replace(
		/cahut\.example\.com|&lt;token&gt;|&quot;Your Name&quot;|--handle you|--user you/g,
		(match) => {
			const [flag, value] = match.startsWith('--') ? match.split(' ') : ['', match];
			return `${flag ? `${flag} ` : ''}<span class="term__var">${value}</span>`;
		},
	);
---

<div class="qs" data-qs data-copied={t.copied}>
	<div class="term" data-theme="dark">
		<div class="term__bar">
			<span class="c-label term__label">{t.install}</span>
			<div class="term__tabs" role="tablist" aria-label={t.install}>
				{
					tabs.map(({ id, label }, index) => (
						<button
							type="button"
							role="tab"
							id={`qs-tab-${id}`}
							aria-controls={`qs-panel-${id}`}
							aria-selected={index === 0 ? 'true' : 'false'}
							tabindex={index === 0 ? 0 : -1}
							data-qs-tab={id}
						>
							{label}
						</button>
					))
				}
			</div>
			{
				tabs.map(({ id, meta }, index) => (
					<span class="c-mono term__meta" data-qs-meta={id} hidden={index !== 0}>
						{meta}
					</span>
				))
			}
		</div>

		{
			tabs.map(({ id, steps, address }, index) => (
				<div
					class="term__panel"
					role="tabpanel"
					id={`qs-panel-${id}`}
					aria-labelledby={`qs-tab-${id}`}
					hidden={index !== 0}
					data-qs-panel={id}
				>
					<ol class="term__steps" role="list">
						{steps.map(({ comment, lines }, step) => (
							<li class="term__step">
								<p class="term__comment">
									# {step + 1} · {comment}
								</p>
								<div class="term__code">
									<div class="term__scroll">
										<code class="term__lines">
											{lines.map((line) => (
												<span class="term__line">
													<span class="term__prompt" aria-hidden="true">
														$
													</span>
													<span set:html={highlight(line)} />
												</span>
											))}
										</code>
									</div>
									<button type="button" class="term__copy" data-copy={lines.join('\n')} aria-label={t.copy}>
										<Icon name="copy" size={14} class="term__copy-icon" />
										<Icon name="check" size={14} class="term__done-icon" />
										<span class="term__copy-text" aria-hidden="true">
											{t.copy}
										</span>
									</button>
								</div>
							</li>
						))}
						<li class="term__step term__step--ask">
							<p class="term__comment">
								# {steps.length + 1} · {t.comments.ask}
							</p>
							<div class="term__chat">
								<p class="term__ask">
									<span class="term__prompt" aria-hidden="true">
										›
									</span>
									<span data-qs-type>{t.prompt}</span>
									<span class="term__caret" aria-hidden="true" />
								</p>
								<p class="term__reply">
									<span class="c-ai__mark">Cl</span>
									<Icon name="circle-check" size={16} />
									<span>
										{t.reply} <span class="term__address">{address}</span>
									</span>
								</p>
							</div>
						</li>
					</ol>
				</div>
			))
		}
		<p class="visually-hidden" role="status" data-qs-status></p>
	</div>

	<div class="qs__foot">
		<div class="qs__needs">
			<p class="c-label">{t.needs.label}</p>
			<ul role="list">
				{
					t.needs.items.map((item) => (
						<li>
							<Icon name="check" size={16} />
							{item}
						</li>
					))
				}
			</ul>
		</div>
		<p class="qs__note">
			<Icon name="info" size={16} />
			<span>
				{t.note}{' '}
				<a href={`${docs}/start/status/`} hreflang={lang === 'en' ? undefined : 'en'}>{t.status}</a>
			</span>
		</p>
	</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-qs]').forEach((root) => {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-qs-tab]')];
		const status = root.querySelector<HTMLElement>('[data-qs-status]')!;
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

		// Tabs, with the arrow keys of a tab list.
		const select = (tab: HTMLButtonElement, focus = false) => {
			const id = tab.dataset.qsTab!;
			tabs.forEach((other) => {
				const on = other === tab;
				other.setAttribute('aria-selected', String(on));
				other.tabIndex = on ? 0 : -1;
			});
			root.querySelectorAll<HTMLElement>('[data-qs-panel], [data-qs-meta]').forEach((element) => {
				element.hidden = (element.dataset.qsPanel ?? element.dataset.qsMeta) !== id;
			});
			if (focus) tab.focus();
			type(root.querySelector<HTMLElement>(`[data-qs-panel="${id}"]`)!);
		};
		tabs.forEach((tab, index) => {
			tab.addEventListener('click', () => select(tab));
			tab.addEventListener('keydown', (event) => {
				const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
				if (!step) return;
				event.preventDefault();
				select(tabs[(index + step + tabs.length) % tabs.length], true);
			});
		});

		// Copy a step, and say so for a moment.
		root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
			const text = button.querySelector<HTMLElement>('.term__copy-text')!;
			const idle = { label: button.getAttribute('aria-label')!, text: text.textContent! };
			const copied = root.dataset.copied ?? idle.text;
			let timer = 0;
			button.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(button.dataset.copy!);
				} catch {
					return;
				}
				button.classList.add('is-copied');
				text.textContent = copied;
				status.textContent = copied;
				clearTimeout(timer);
				timer = window.setTimeout(() => {
					button.classList.remove('is-copied');
					text.textContent = idle.text;
					status.textContent = '';
				}, 2000);
			});
		});

		// The request to the AI types itself once, then the AI answers.
		const typed = new WeakSet<HTMLElement>();
		function type(panel: HTMLElement) {
			const step = panel.querySelector<HTMLElement>('.term__step--ask')!;
			const target = step.querySelector<HTMLElement>('[data-qs-type]')!;
			if (typed.has(step) || reduced) {
				step.classList.add('is-answered');
				return;
			}
			typed.add(step);
			const text = target.textContent!;
			target.textContent = '';
			step.classList.add('is-typing');
			let index = 0;
			const next = () => {
				target.textContent = text.slice(0, ++index);
				if (index < text.length) return setTimeout(next, 22 + Math.random() * 30);
				step.classList.remove('is-typing');
				setTimeout(() => step.classList.add('is-answered'), 500);
			};
			setTimeout(next, 400);
		}

		root.classList.add('is-ready');
		const observer = new IntersectionObserver(
			([entry]) => {
				if (!entry.isIntersecting) return;
				observer.disconnect();
				type(root.querySelector<HTMLElement>('[data-qs-panel]:not([hidden])')!);
			},
			{ threshold: 0.5 },
		);
		observer.observe(root.querySelector('.term')!);
	});
</script>

<style>
	.qs {
		display: grid;
		gap: var(--space-8);
	}
	.qs p {
		margin: 0;
	}

	/* The terminal keeps the dark theme in both themes of the page. */
	.term {
		position: relative;
		overflow: hidden;
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-xl);
		background: var(--color-bg);
		color: var(--color-text);
		box-shadow: var(--shadow-lg);
	}
	.term__bar {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		padding: 0 var(--space-6);
		border-bottom: var(--border-width) solid var(--color-border);
		background: var(--color-surface);
	}
	.term__label {
		flex: none;
	}
	.term__tabs {
		display: flex;
		gap: var(--space-1);
		margin-right: auto;
	}
	.term__tabs button {
		position: relative;
		padding: var(--space-4) var(--space-3);
		border: 0;
		background: none;
		color: var(--color-text-muted);
		font: inherit;
		font-size: var(--text-sm);
		line-height: var(--leading-sm);
		font-weight: var(--weight-semibold);
		cursor: pointer;
		transition: color var(--duration-base) var(--ease-out);
	}
	.term__tabs button:hover,
	.term__tabs button[aria-selected='true'] {
		color: var(--color-text);
	}
	.term__tabs button::after {
		content: '';
		position: absolute;
		left: var(--space-3);
		right: var(--space-3);
		bottom: -1px;
		height: 2px;
		border-radius: var(--radius-pill);
		background: var(--color-accent);
		transform: scaleX(0);
		transition: transform var(--duration-slow) var(--ease-out);
	}
	.term__tabs button[aria-selected='true']::after {
		transform: none;
	}
	.term__meta {
		color: var(--color-text-muted);
		font-size: var(--text-xs);
		line-height: var(--leading-xs);
		white-space: nowrap;
	}

	.term__panel {
		padding: var(--space-6);
	}
	.term__steps {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-5);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.term__step {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-2);
	}
	.term__comment {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		line-height: var(--leading-sm);
		font-style: italic;
	}
	.term__code {
		position: relative;
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
	}
	.term__scroll {
		padding: var(--space-3) 7rem var(--space-3) var(--space-4);
		overflow-x: auto;
		scrollbar-width: thin;
	}
	.term__lines {
		display: grid;
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		line-height: var(--leading-base);
	}
	.term__line {
		white-space: pre;
	}
	.term__prompt {
		margin-right: 1ch;
		color: var(--color-text-disabled);
		user-select: none;
	}
	.term__code :global(.term__var) {
		color: var(--color-link);
	}
	.term__copy {
		position: absolute;
		top: var(--space-2);
		right: var(--space-2);
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		height: 28px;
		padding: 0 var(--space-2);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-surface-muted);
		color: var(--color-text-muted);
		font: inherit;
		font-size: var(--text-xs);
		line-height: var(--leading-xs);
		font-weight: var(--weight-semibold);
		cursor: pointer;
		transition:
			color var(--duration-fast) var(--ease-out),
			border-color var(--duration-fast) var(--ease-out);
	}
	.term__copy:hover {
		border-color: var(--color-border-strong);
		color: var(--color-text);
	}
	.term__copy :global(.term__done-icon),
	.term__copy.is-copied :global(.term__copy-icon) {
		display: none;
	}
	.term__copy.is-copied :global(.term__done-icon) {
		display: block;
	}
	.term__copy.is-copied {
		color: var(--color-success);
	}

	/* The request to the AI, and its answer. */
	.term__chat {
		display: grid;
		gap: var(--space-2);
		padding: var(--space-4);
		border: var(--border-width) dashed var(--color-border-strong);
		border-radius: var(--radius-md);
		font-size: var(--text-sm);
		line-height: var(--leading-sm);
	}
	.term__ask {
		color: var(--color-text);
	}
	.term__caret {
		display: none;
		width: 0.55em;
		height: 1.1em;
		margin-left: 2px;
		vertical-align: text-bottom;
		background: var(--color-accent);
	}
	.is-typing .term__caret {
		display: inline-block;
		animation: blink 1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	.term__reply {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-2);
		color: var(--color-text-muted);
	}
	.term__reply :global(.i) {
		color: var(--color-success);
	}
	.term__address {
		color: var(--color-link);
		font-family: var(--font-mono);
		overflow-wrap: anywhere;
	}
	/* With scripts, the answer comes once the request is typed. */
	:global(.js) .qs.is-ready .term__reply {
		opacity: 0;
		translate: 0 var(--space-1);
		transition:
			opacity var(--duration-reveal) var(--ease-out),
			translate var(--duration-reveal) var(--ease-out);
	}
	:global(.js) .qs.is-ready .is-answered .term__reply {
		opacity: 1;
		translate: none;
	}

	/* Under the terminal */
	.qs__foot {
		display: grid;
		grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
		gap: var(--space-8);
		align-items: start;
	}
	.qs__needs {
		display: grid;
		gap: var(--space-3);
	}
	.qs__needs ul {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-2) var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-sm);
		line-height: var(--leading-sm);
	}
	.qs__needs li {
		display: flex;
		align-items: start;
		gap: var(--space-2);
	}
	.qs__needs li :global(.i) {
		flex: none;
		margin-top: 2px;
		color: var(--color-success);
	}
	.qs__note {
		display: flex;
		align-items: start;
		gap: var(--space-3);
		padding: var(--space-4);
		border: var(--border-width) solid var(--color-info-border);
		border-radius: var(--radius-md);
		background: var(--color-info-bg);
		font-size: var(--text-sm);
		line-height: var(--leading-sm);
	}
	.qs__note :global(.i) {
		flex: none;
		margin-top: 2px;
		color: var(--color-info);
	}

	@media (max-width: 860px) {
		.term__meta {
			display: none;
		}
		.qs__foot {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 640px) {
		.term__bar {
			gap: var(--space-3);
			padding: 0 var(--space-4);
		}
		.term__label {
			display: none;
		}
		.term__tabs button {
			padding-inline: var(--space-2);
		}
		.term__panel {
			padding: var(--space-4);
		}
		.term__scroll {
			padding-right: 3rem;
		}
		.term__lines {
			font-size: var(--text-xs);
			line-height: var(--leading-sm);
		}
		.term__copy-text {
			display: none;
		}
		.qs__needs ul {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.qs :global(*) {
			transition-duration: 1ms !important;
		}
	}
</style>
