export type IconName = keyof typeof icons;

interface Props {
	name: IconName;
	size?: 14 | 16 | 20 | 24;
	class?: string;
}

const { name, size = 16, class: className } = Astro.props;
---

<svg
	class:list={['i', className]}
	aria-hidden="true"
	xmlns="http://www.w3.org/2000/svg"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	set:html={icons[name]}
/>
