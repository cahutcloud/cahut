---
// The frame of every page of cahut.cloud: head, header and footer.
import '@charte/tokens/cahut-fonts.css';
import '@charte/tokens/cahut-tokens.css';
import '@charte/ui/cahut-ui.css';
import '../styles/site.css';
import logo from '@charte/logos/cahut-logo-horizontal.svg?url';
import logoInverse from '@charte/logos/cahut-logo-horizontal-inverse.svg?url';
import defaultImage from '@charte/applications/og-image.png';
import tokens from '@charte/tokens/cahut-tokens.json';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description: string;
	/** The image shown when the page is shared, 1200 × 630. Defaults to the brand's. */
	image?: ImageMetadata;
	/** What the image shows, for those who cannot see it. */
	imageAlt?: string;
	/** Leaves the width of the page to its own sections, instead of the margins of the site. */
	fullWidth?: boolean;
	/** Keeps the page out of search engines, and gives it no canonical address. */
	noindex?: boolean;
}

const {
	title,
	description,
	image = defaultImage,
	imageAlt = 'Your own cloud for everything your AI makes. Documents, decks, dashboards and apps, in your house style, on your own server.',
	fullWidth = false,
	noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image.src, Astro.site);
const path = Astro.url.pathname;

const nav = [
	{ href: 'https://docs.cahut.cloud', label: 'Docs' },
	{ href: '/brand/', label: 'Brand' },
	{ href: 'https://github.com/getcahut/cahut', label: 'GitHub' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content={tokens.color.brand.paper.$value} media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content={tokens.color.ink['950'].$value} media="(prefers-color-scheme: dark)" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Cahut" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{!noindex && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:type" content={`image/${image.format}`} />
		<meta property="og:image:width" content={String(image.width)} />
		<meta property="og:image:height" content={String(image.height)} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<header class="site-header">
			<div class="container bar">
				<a href="/" class="logo">
					<picture>
						<source srcset={logoInverse} media="(prefers-color-scheme: dark)" />
						<img src={logo} alt="Cahut, home" width="138" height="28" />
					</picture>
				</a>
				<nav aria-label="Main">
					<ul>
						{
							nav.map(({ href, label }) => (
								<li>
									<a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
										{label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>
		<main id="content" class:list={{ container: !fullWidth, page: !fullWidth }}>
			<slot />
		</main>
		<footer class="site-footer" data-theme="dark">
			<div class="container">
				<div class="signature">
					<img src={logoInverse} alt="Cahut" width="138" height="28" />
					<p>Your own cloud for everything your AI makes.</p>
				</div>
				<nav aria-label="Footer">
					<ul>
						{
							nav.map(({ href, label }) => (
								<li>
									<a href={href}>{label}</a>
								</li>
							))
						}
					</ul>
				</nav>
				<div class="about">
					<p class="c-small c-muted">
						Cahut is a personal open source project by Olivier Durand, independent of any company and of any AI
						vendor. It is in early development: nothing is usable yet.
					</p>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	main {
		flex: 1;
	}
	.page {
		padding-block: var(--space-12) var(--space-24);
	}

	.skip-link {
		position: absolute;
		top: var(--space-2);
		left: var(--space-2);
		z-index: 1;
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-md);
		background: var(--color-primary);
		color: var(--color-on-primary);
		font-weight: var(--weight-semibold);
		transform: translateY(-200%);
	}
	.skip-link:focus-visible {
		transform: none;
	}

	.site-header {
		border-bottom: var(--border-width) solid var(--color-border);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-6);
		min-height: var(--space-16);
	}
	.logo {
		display: block;
		border-radius: var(--radius-sm);
	}
	.logo img {
		display: block;
		height: 28px;
		width: auto;
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	nav a {
		display: block;
		padding-block: var(--space-2);
		border-radius: var(--radius-xs);
		color: var(--color-text);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		text-decoration: none;
	}
	nav a:hover {
		text-decoration: underline;
	}
	nav a[aria-current='page'] {
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 6px;
	}

	.site-footer {
		padding-block: var(--space-12);
		background: var(--color-surface);
		color: var(--color-text);
	}
	.site-footer .container {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: start;
		gap: var(--space-8);
	}
	.signature {
		display: grid;
		gap: var(--space-3);
	}
	.signature img {
		height: 28px;
		width: auto;
	}
	.signature p {
		margin: 0;
		font-weight: var(--weight-semibold);
	}
	.site-footer .about {
		grid-column: 1 / -1;
		padding-top: var(--space-6);
		border-top: var(--border-width) solid var(--color-border);
	}
	.site-footer .about p {
		max-width: var(--measure);
		margin: 0;
	}
	@media (max-width: 640px) {
		.site-footer .container {
			grid-template-columns: 1fr;
		}
	}
</style>
