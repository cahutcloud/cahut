---
// The frame of every page of cahut.cloud: head, header and footer.
import '@charte/tokens/cahut-fonts.css';
import '@charte/tokens/cahut-tokens.css';
import '@charte/ui/cahut-ui.css';
import '../styles/site.css';
import Icon from '../components/Icon.astro';
import { localize, otherLang, useTranslations, type Lang } from '../i18n';
import { legalPages, legalPaths } from '../legal/legal';
import { pages, paths } from '../project/community';
import logo from '@charte/logos/cahut-logo-horizontal.svg?url';
import logoInverse from '@charte/logos/cahut-logo-horizontal-inverse.svg?url';
import defaultImage from '@charte/applications/og-image.png';
import tokens from '@charte/tokens/cahut-tokens.json';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description: string;
	/** The language of the page. Defaults to English. */
	lang?: Lang;
	/** The address of this page in each language it exists in. Other languages lead to their home page. */
	alternates?: Partial<Record<Lang, string>>;
	/** The image shown when the page is shared, 1200 × 630. Defaults to the brand's. */
	image?: ImageMetadata;
	/** What the image shows, for those who cannot see it. */
	imageAlt?: string;
	/** Leaves the width of the page to its own sections, instead of the margins of the site. */
	fullWidth?: boolean;
	/** Keeps the page out of search engines, and gives it no canonical address. */
	noindex?: boolean;
}

const {
	title,
	description,
	lang = 'en',
	alternates = {},
	image = defaultImage,
	fullWidth = false,
	noindex = false,
} = Astro.props;
const t = useTranslations(lang);
const imageAlt = Astro.props.imageAlt ?? t.meta.imageAlt;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image.src, Astro.site);
const path = Astro.url.pathname;
const other = otherLang(lang);
const otherHref = alternates[other] ?? localize(other, '/');

const github = 'https://github.com/getcahut/cahut';
const docs = 'https://docs.cahut.cloud';
// The accounts of Cahut, in the order of the channels of the governance: Mastodon
// and LinkedIn carry the news, YouTube and X follow.
const social = [
	{ href: 'https://mastodon.social/@cahut', label: 'Mastodon' },
	{ href: 'https://www.linkedin.com/company/cahut', label: 'LinkedIn' },
	{ href: 'https://www.youtube.com/@CahutCloud', label: 'YouTube' },
	{ href: 'https://x.com/getcahut', label: 'X' },
];
const home = (hash: string) => localize(lang, `/${hash}`);

// The sections of the home page come first; small screens keep only the rest.
const nav = [
	{ href: home('#how-it-works'), label: t.base.nav.how, section: true },
	{ href: home('#knock-first'), label: t.base.nav.knock, section: true },
	{ href: home('#features'), label: t.base.nav.features, section: true },
	{ href: docs, label: t.base.nav.docs, hreflang: 'en' },
	{ href: localize(lang, '/project/'), label: t.base.nav.project, optional: true },
	{ href: '/brand/', label: t.base.nav.brand, hreflang: 'en', optional: true },
];

const footer: { title: string; links: { href: string; label: string; hreflang?: string; rel?: string }[] }[] = [
	{
		title: t.base.footer.cahut,
		links: [
			{ href: home('#quickstart'), label: t.base.nav.quickstart },
			{ href: home('#how-it-works'), label: t.base.nav.how },
			{ href: home('#knock-first'), label: t.base.nav.knock },
			{ href: home('#features'), label: t.base.nav.features },
		],
	},
	{
		// The pages of the project section (ADR 18), then the docs, the brand and the repository.
		title: t.base.footer.project,
		links: [
			...pages.map((page) => ({ href: localize(lang, paths[page]), label: t.project.nav[page] })),
			{ href: docs, label: t.base.nav.docs, hreflang: 'en' },
			{ href: '/brand/', label: t.base.nav.brand, hreflang: 'en' },
			{ href: github, label: t.base.nav.github },
		],
	},
	{
		// rel="me" tells each network that the site and the account belong to the same project.
		title: t.base.footer.follow,
		links: social.map((account) => ({ ...account, rel: 'me' })),
	},
];
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		{
			!noindex &&
				Object.entries(alternates).map(([language, href]) => (
					<link rel="alternate" hreflang={language} href={new URL(href, Astro.site)} />
				))
		}
		{!noindex && alternates.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site)} />}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="color-scheme" content="light dark" />
		<meta
			name="theme-color"
			content={tokens.color.brand.paper.$value}
			media="(prefers-color-scheme: light)"
			data-theme-color="light"
		/>
		<meta
			name="theme-color"
			content={tokens.color.ink['950'].$value}
			media="(prefers-color-scheme: dark)"
			data-theme-color="dark"
		/>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Cahut" />
		<meta property="og:locale" content={t.meta.locale} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{!noindex && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:type" content={`image/${image.format}`} />
		<meta property="og:image:width" content={String(image.width)} />
		<meta property="og:image:height" content={String(image.height)} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@getcahut" />
		<meta name="fediverse:creator" content="@cahut@mastodon.social" />

		<!--
			Before the first paint: the theme the visitor chose, and what reveals
			itself on scroll starts hidden only when scripts run.
		-->
		<script is:inline>
			document.documentElement.classList.add('js');
			try {
				const theme = localStorage.getItem('cahut-theme');
				if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
			} catch {}
		</script>
	</head>
	<body>
		<a class="skip-link" href="#content">{t.base.skip}</a>
		<header class="site-header" data-header>
			<div class="container bar">
				<a href={localize(lang)} class="logo">
					<img class="logo-light" src={logo} alt={t.base.home} width="138" height="28" />
					<img class="logo-dark" src={logoInverse} alt={t.base.home} width="138" height="28" />
				</a>
				<nav aria-label={t.base.mainNav}>
					<ul>
						{
							nav.map(({ href, label, section, optional, hreflang }) => (
								<li class:list={{ 'in-page': section, optional }}>
									<a
										href={href}
										hreflang={hreflang !== lang ? hreflang : undefined}
										aria-current={!section && href.startsWith('/') && path.startsWith(href) ? 'page' : undefined}
									>
										{label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
				<div class="tools">
					<a class="tool lang" href={otherHref} hreflang={other} lang={other} title={t.base.language.label}>
						<span aria-hidden="true">{t.base.language.short}</span>
						<span class="visually-hidden">{t.base.language.label}</span>
					</a>
					<button
						type="button"
						class="tool"
						data-theme-toggle
						data-label-dark={t.base.theme.dark}
						data-label-light={t.base.theme.light}
						aria-label={t.base.theme.dark}
						title={t.base.theme.dark}
					>
						<Icon name="moon" size={16} class="to-dark" />
						<Icon name="sun" size={16} class="to-light" />
					</button>
					<a class="c-btn c-btn--primary c-btn--sm github" href={github}>GitHub <Icon name="arrow-right" size={14} /></a>
				</div>
			</div>
		</header>
		<main id="content" class:list={{ container: !fullWidth, page: !fullWidth }}>
			<slot />
		</main>
		<footer class="site-footer" data-theme="dark">
			<div class="container">
				<div class="signature">
					<img src={logoInverse} alt="Cahut" width="138" height="28" />
					<p>{t.base.signature}</p>
				</div>
				{
					footer.map(({ title, links }) => (
						<nav aria-label={title}>
							<p class="c-label">{title}</p>
							<ul>
								{links.map(({ href, label, hreflang, rel }) => (
									<li>
										<a href={href} hreflang={hreflang !== lang ? hreflang : undefined} rel={rel}>
											{label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					))
				}
				<div class="about">
					<p class="c-small c-muted">{t.base.about}</p>
					<ul class="c-small" role="list">
						{
							legalPages.map((page) => (
								<li>
									<a href={localize(lang, legalPaths[page])}>{t.legal.nav[page]}</a>
								</li>
							))
						}
						<li>
							<a href={otherHref} hreflang={other} lang={other}>{t.base.language.label}</a>
						</li>
					</ul>
				</div>
			</div>
		</footer>
	</body>
</html>

<script>
	// The header takes a border once the page scrolls under it.
	const header = document.querySelector('[data-header]');
	const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 4);
	onScroll();
	addEventListener('scroll', onScroll, { passive: true });

	// The theme follows the system until the visitor picks one, which stays.
	const root = document.documentElement;
	const systemDark = matchMedia('(prefers-color-scheme: dark)');
	const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : systemDark.matches);
	const colors = [...document.querySelectorAll<HTMLMetaElement>('[data-theme-color]')];
	const shades = Object.fromEntries(colors.map((meta) => [meta.dataset.themeColor, meta.content]));
	const paintBar = () => {
		if (root.dataset.theme) colors.forEach((meta) => (meta.content = shades[root.dataset.theme!]));
	};
	paintBar();
	document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
		const label = () => {
			const text = isDark() ? button.dataset.labelLight! : button.dataset.labelDark!;
			button.setAttribute('aria-label', text);
			button.title = text;
		};
		label();
		systemDark.addEventListener('change', label);
		button.addEventListener('click', () => {
			root.dataset.theme = isDark() ? 'light' : 'dark';
			try {
				localStorage.setItem('cahut-theme', root.dataset.theme);
			} catch {
				// Private windows may refuse storage: the theme then lasts for this page.
			}
			label();
			paintBar();
		});
	});

	// The children of a group reveal one after the other.
	for (const group of document.querySelectorAll('[data-reveal-group]')) {
		group.querySelectorAll<HTMLElement>('[data-reveal]').forEach((element, index) => {
			element.style.setProperty('--reveal-delay', `${Math.min(index, 8) * 70}ms`);
		});
	}

	const reveal = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					reveal.unobserve(entry.target);
				}
			}
		},
		{ rootMargin: '0px 0px -8% 0px' },
	);
	document.querySelectorAll('[data-reveal]').forEach((element) => reveal.observe(element));
</script>

<style>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	main {
		flex: 1;
	}
	.page {
		padding-block: var(--space-12) var(--space-24);
	}

	.skip-link {
		position: absolute;
		top: var(--space-2);
		left: var(--space-2);
		z-index: 100;
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-md);
		background: var(--color-primary);
		color: var(--color-on-primary);
		font-weight: var(--weight-semibold);
		transform: translateY(-200%);
	}
	.skip-link:focus-visible {
		transform: none;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: var(--border-width) solid transparent;
		background: color-mix(in srgb, var(--color-bg) 82%, transparent);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
		transition: border-color var(--duration-slow) var(--ease-out);
	}
	.site-header.is-scrolled {
		border-bottom-color: var(--color-border);
	}
	.bar {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		min-height: var(--header-height);
	}
	.logo {
		display: block;
		margin-right: auto;
		border-radius: var(--radius-sm);
	}
	.logo img {
		display: block;
		height: 28px;
		width: auto;
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	nav a {
		display: block;
		padding-block: var(--space-2);
		border-radius: var(--radius-xs);
		color: var(--color-text);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		text-decoration: none;
	}
	.bar nav a {
		position: relative;
	}
	/* A line grows under the link, from its left. */
	.bar nav a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 2px;
		height: 2px;
		border-radius: var(--radius-pill);
		background: currentColor;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--duration-slow) var(--ease-out);
	}
	.bar nav a:hover::after {
		transform: scaleX(1);
	}
	.bar nav a[aria-current='page']::after {
		background: var(--color-accent);
		transform: scaleX(1);
	}
	.github {
		flex: none;
	}

	/* The other language and the theme, as small square tools. */
	.tools {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
	.tool {
		display: inline-grid;
		place-items: center;
		width: var(--space-8);
		height: var(--space-8);
		padding: 0;
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		line-height: var(--leading-xs);
		font-weight: var(--weight-semibold);
		text-decoration: none;
		cursor: pointer;
		transition:
			background var(--duration-fast) var(--ease-out),
			border-color var(--duration-fast) var(--ease-out);
	}
	.tool:hover {
		border-color: var(--color-border-strong);
		background: var(--color-surface-muted);
	}
	.tool :global(.i) {
		transition: rotate var(--duration-slow) var(--ease-out);
	}
	.tool:hover :global(.i) {
		rotate: 20deg;
	}

	/*
	 * The logo and the icon of the theme follow the theme in use: the one the
	 * visitor picked, or else the system's.
	 */
	.logo-dark,
	.tool :global(.to-light) {
		display: none !important;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .logo-light,
		:global(:root:not([data-theme='light'])) .tool :global(.to-dark) {
			display: none !important;
		}
		:global(:root:not([data-theme='light'])) .logo-dark,
		:global(:root:not([data-theme='light'])) .tool :global(.to-light) {
			display: block !important;
		}
	}
	:global(:root[data-theme='dark']) .logo-light,
	:global(:root[data-theme='dark']) .tool :global(.to-dark) {
		display: none !important;
	}
	:global(:root[data-theme='dark']) .logo-dark,
	:global(:root[data-theme='dark']) .tool :global(.to-light) {
		display: block !important;
	}

	.site-footer {
		padding-block: var(--space-16) var(--space-12);
		background: var(--color-surface);
		color: var(--color-text);
	}
	.site-footer .container {
		display: grid;
		grid-template-columns: 1fr auto auto auto;
		align-items: start;
		gap: var(--space-8) var(--space-16);
	}
	.signature {
		display: grid;
		gap: var(--space-3);
	}
	.signature img {
		height: 28px;
		width: auto;
	}
	.signature p {
		margin: 0;
		font-weight: var(--weight-semibold);
	}
	.site-footer nav {
		display: grid;
		gap: var(--space-3);
	}
	.site-footer nav p {
		margin: 0;
	}
	.site-footer nav ul {
		display: grid;
		gap: var(--space-1);
	}
	.site-footer nav a {
		padding-block: var(--space-1);
	}
	.site-footer nav a:hover {
		text-decoration: underline;
	}
	.site-footer .about {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-4) var(--space-8);
		padding-top: var(--space-6);
		border-top: var(--border-width) solid var(--color-border);
	}
	.site-footer .about p {
		max-width: var(--measure);
		margin: 0;
	}
	/* The legal pages, then the other language. */
	.site-footer .about ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.site-footer .about a:hover {
		text-decoration: underline;
	}

	/* The signature takes a row of its own, above the links. */
	@media (max-width: 900px) {
		.in-page {
			display: none;
		}
		.site-footer .container {
			grid-template-columns: repeat(3, 1fr);
		}
		.signature {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 640px) {
		.bar {
			gap: var(--space-4);
		}
		.bar nav ul {
			flex-wrap: nowrap;
			gap: var(--space-4);
		}
		.site-footer .container {
			grid-template-columns: 1fr 1fr;
		}
	}
	/* The brand and GitHub stay in the footer when the header runs out of room. */
	@media (max-width: 480px) {
		.optional,
		.github {
			display: none;
		}
	}
</style>
