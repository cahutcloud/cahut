---
import Colors from '../../components/brand/Colors.astro';
import Files from '../../components/brand/Files.astro';
import HouseStyle from '../../components/brand/HouseStyle.astro';
import Icon from '../../components/brand/Icon.astro';
import Illustrations from '../../components/brand/Illustrations.astro';
import Logo from '../../components/brand/Logo.astro';
import Name from '../../components/brand/Name.astro';
import Type from '../../components/brand/Type.astro';
import Words from '../../components/brand/Words.astro';
import { size, url } from '../../components/brand/files';
import Base from '../../layouts/Base.astro';
// After the layout, so that the page's rules come after those of the interface kit.
import '../../components/brand/brand.css';

const sections = [
	['name', 'Name'],
	['words', 'Words'],
	['logo', 'Logo'],
	['colors', 'Colors'],
	['type', 'Type'],
	['illustrations', 'Illustrations'],
	['house-style', 'House style'],
	['files', 'Files'],
];

const pdf = 'charte-graphique-cahut.pdf';
---

<Base
	title="Brand · Cahut"
	description="The Cahut brand: its name, logo, colors, type, pictograms and illustrations, the rules for using them, and the files to download."
>
	<div class="b-page">
		<div class="b-intro">
			<header class="b-hero">
			<div class="b-hero__text">
				<p class="c-label">Brand</p>
				<h1 class="c-display">The Cahut brand</h1>
				<p class="b-lead">
					Cahut is a simple shelter of your own, set in the cloud. Its brand is warm paper, blue-grey ink, a touch of
					sky and a rare ray of sun. Here are its name, logo, colors, type and pictures, the few rules that keep them
					whole, and the files to download.
				</p>
				<p class="b-hero__actions">
					<a class="c-btn c-btn--primary" href="#logo">Get the logos</a>
					<a class="c-btn c-btn--secondary" href={url(pdf)} hreflang="fr" type="application/pdf">
						<Icon name="download" />
						Full guidelines
					</a>
					<span class="c-small c-muted c-mono">PDF · {size(pdf)} · French</span>
				</p>
			</div>
			<div class="b-hero__art b-art--paper">
				<img src={url('illustrations/maison-ouverte.svg')} alt="" width="1200" height="800" />
			</div>
		</header>

		<nav class="b-toc" aria-label="On this page">
			<ul role="list">
				{
					sections.map(([id, label]) => (
						<li>
							<a href={`#${id}`}>{label}</a>
						</li>
					))
				}
			</ul>
		</nav>
		</div>

		<Name />
		<Words />
		<Logo />
		<Colors />
		<Type />
		<Illustrations />
		<HouseStyle />
		<Files />
	</div>
</Base>
