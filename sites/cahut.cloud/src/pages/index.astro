---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import cahutPicto from '@charte/icones/cahut.svg?raw';
import houseStylePicto from '@charte/icones/house-style.svg?raw';
import keyPicto from '@charte/icones/key.svg?raw';
import knockFirstPicto from '@charte/icones/knock-first.svg?raw';
import logbookPicto from '@charte/icones/logbook.svg?raw';
import roomPicto from '@charte/icones/room.svg?raw';
import windowPicto from '@charte/icones/window.svg?raw';
import openHouse from '@charte/illustrations/maison-ouverte.svg?url';

const github = 'https://github.com/getcahut/cahut';
const docs = 'https://docs.cahut.cloud';

const problems = [
	{
		title: 'Scattered',
		text: 'A Claude link here, a ChatGPT link there, a Gamma deck somewhere else. Each AI keeps what it makes on its own service.',
	},
	{
		title: 'Converted back',
		text: 'For lack of anything better, the result is turned back into a PowerPoint or a Word file so it can be shared and filed.',
	},
	{
		title: 'Uncontrolled',
		text: 'Who has access, until when, which version is the right one, where the data lives. Nobody really knows.',
	},
	{
		title: 'Inconsistent',
		text: "Every AI has its own style, and the organization's brand gets lost.",
	},
	{
		title: 'Unguarded',
		text: 'Handing a server to an AI means giving it a root shell, or going through a platform built for humans that it can barely use.',
	},
];

const layers = [
	{
		layer: 'Create',
		who: 'The AIs',
		what: 'Claude, ChatGPT, Mistral, Copilot and others make the content: documents, decks, dashboards, apps.',
	},
	{
		layer: 'Keep and share',
		who: 'Cahut, on your server',
		what: 'Publishing, links, permissions, versions, comments, search, export and the logbook.',
	},
	{
		layer: 'Look and feel',
		who: 'The house style, carried by Cahut',
		what: 'Your colors and formats, given to every AI as templates and skills.',
	},
];

const features = [
	{
		area: 'Installation',
		text: 'One command on a fresh VPS or dedicated server (AlmaLinux or Ubuntu), a guided first start, and the linking of the admin and their first AI.',
	},
	{
		area: 'AI access',
		text: 'A native MCP server (HTTP, OAuth) and one skill per AI client, packaged as a plugin where the client allows it: Claude first, then ChatGPT, Mistral, Copilot and others. SSH access limited to the same operations, for terminal AIs.',
	},
	{
		area: 'Pages',
		text: 'Documents, decks, dashboards and static sites, each at its own address in its Room.',
	},
	{
		area: 'Apps',
		text: 'Predefined runtimes, such as Node and Python, and an advanced Dockerfile mode. Variables and secrets, PostgreSQL or SQLite databases, runtime logs, resource limits.',
	},
	{
		area: 'Sharing',
		text: 'By link, Window by Window: its Room only, internal (everyone in the Cahut), a Key (a password) or public, with an optional end date.',
	},
	{
		area: 'Versions',
		text: 'Two versions kept per publication. Roll back in one gesture.',
	},
	{ area: 'Comments', text: 'Reader feedback directly on the pages.' },
	{ area: 'Search', text: 'Find any page, deck or dashboard across everything published.' },
	{ area: 'Export', text: 'PDF and PowerPoint, for recipients still on Office.' },
	{
		area: 'House style',
		text: "The organization's colors, fonts, logos and templates, given to every AI so everything comes out on brand.",
	},
	{
		area: 'Users and Rooms',
		text: 'The people of each Cahut and its admins, a personal Room for each person, team Rooms with owners and members.',
	},
	{
		area: 'Sign-in',
		text: 'Accounts of each Cahut, and single sign-on with OpenID Connect: Google, Microsoft Entra, Okta and others.',
	},
	{
		area: 'Web console',
		text: 'See what is published, share, comment, approve irreversible actions, administer the server and its Cahuts, on its own HTTPS port.',
	},
	{
		area: 'Domains and TLS',
		text: 'Several Cahuts per server, each at its own domain or subdomain. No wildcard needed, automatic certificates.',
	},
	{
		area: 'Logbook',
		text: 'The history of every action: who, which AI, on whose behalf, with what result.',
	},
	{
		area: 'Backups',
		text: 'Optional, to external S3 or SFTP storage. Restore from the console.',
	},
	{
		area: 'Updates',
		text: 'Automatic, checked against the releases published on GitHub, with rollback.',
	},
];

const notDone = [
	"Create content: that is the AIs' job.",
	'Run an AI model on the server: the AIs stay outside and connect to it.',
	'Depend on one AI vendor, or lock work into a proprietary format.',
	'Give an AI free access to the server.',
	'Run across several machines: one server holds one or more Cahuts.',
];

const alone = [
	'Publish or update a Window (the previous version is kept)',
	'Restrict access, extend a lifetime',
	'Deploy an app within the set limits',
	'Roll back to the previous version',
	'Run a backup',
];

const approved = [
	'Permanently delete a Window, an app or a database',
	'Make a Window public',
	'Add a person to a Cahut',
	'Change the permissions of a user or an AI',
	'Erase backups or change their destination',
];

const principles = [
	{
		title: 'Bounded operations',
		text: 'The AI acts through typed operations (publish a page, create a database, share a link), never through a free shell, over MCP as over SSH.',
	},
	{
		title: 'Reversible or approved',
		text: 'What can be undone, the AI does alone. What cannot waits for a human to approve it in the console, with a notification and an expiry.',
	},
	{
		title: 'The AI declares what it publishes',
		text: 'Each publication states what it contains and what it does: an app that collects data, calls out, opens a form.',
	},
	{
		title: 'Per-agent permissions',
		text: 'Each AI acts on behalf of a person, with the scope that person grants, revocable at any time.',
	},
	{
		title: 'Everything is logged',
		text: 'Which AI, on whose behalf, which action, which result: the logbook is readable in the console.',
	},
	{
		title: 'Data stays home',
		text: 'Everything lives on your server. Backups only go to the external storage you choose.',
	},
	{
		title: 'Isolation',
		text: "Each Window runs in a sandbox: its scripts cannot read the other Windows, the console or the reader's session. Each app runs in an unprivileged container with its own resource limits. The Cahuts of one server share nothing but the machine.",
	},
];

const vocabulary = [
	{
		word: 'Cahut',
		picto: cahutPicto,
		meaning: 'An instance on your server, at its own domain. One server can hold several.',
	},
	{
		word: 'Room',
		picto: roomPicto,
		meaning: 'A personal or team space, with its members, at',
		address: '<domain>/<room>',
	},
	{
		word: 'Window',
		picto: windowPicto,
		meaning: 'A living page: document, deck, dashboard or app, at',
		address: '<domain>/<room>/<window>',
	},
	{ word: 'Key', picto: keyPicto, meaning: 'The password that opens a protected Window.' },
	{ word: 'House style', picto: houseStylePicto, meaning: "The organization's brand, applied by every AI." },
	{
		word: 'Knock first',
		picto: knockFirstPicto,
		meaning: 'The governance rule: the AI knocks before any irreversible action.',
	},
	{ word: 'Logbook', picto: logbookPicto, meaning: 'The record of every action.' },
];

const roadmap = [
	{ step: 'Protect the name: GitHub organization, package names, trademark search.' },
	{ step: 'Write the target architecture: compare the options and settle them, with their reasons.' },
	{
		step: 'Build the first vertical slice in Go: install on a server, publish a page over MCP, serve it over HTTPS.',
		current: true,
	},
	{ step: 'Proof of concept: Cahut installed on a fresh VPS, an AI publishing a deck over MCP, the console.' },
	{ step: 'Roadmap to the public launch.' },
];

const criteria = [
	{ criterion: 'Install on a fresh VPS', threshold: 'Under 10 minutes, one command' },
	{ criterion: 'First publication by an AI', threshold: 'Under 5 minutes, without touching the server' },
	{ criterion: 'Sharing by a non-technical person', threshold: 'A deck shared by link in a few minutes' },
	{ criterion: 'Supported AIs', threshold: 'The same Cahut works with at least two different AI clients' },
	{
		criterion: 'Governance',
		threshold: 'Every AI action is in the logbook, and is either reversible or was approved',
	},
];
---

<Base
	title="Cahut: the home for everything your AIs make"
	description="Documents, slide decks, dashboards and small apps live online as living pages, in your house style, on your own server, whichever AI made them. Cahut is in early development."
	fullWidth
>
	<section class="hero container" aria-labelledby="hero-title">
		<div class="hero__text">
			<p class="c-badge c-badge--neutral status"><span class="c-dot"></span>In early development</p>
			<h1 id="hero-title" class="c-display">The home for everything your AIs make.</h1>
			<p class="lead">
				Documents, slide decks, dashboards and small apps live online as living pages, in your house style, on your
				own server, whichever AI made them.
			</p>
			<p>
				Cahut installs with one command on a Linux server. Claude, ChatGPT, Mistral or Copilot publish to it over MCP,
				and you share a link instead of sending a file. The AI does on its own what can be undone, a human approves
				the rest, and every action is logged.
			</p>
			<div class="c-alert c-alert--info notice" role="note">
				<Icon name="info" size={20} />
				<p>
					<strong>Nothing is usable yet.</strong>
					Cahut is in early development. This page describes the target for the public launch.
				</p>
			</div>
			<div class="actions">
				<a class="c-btn c-btn--primary" href={github}>Follow the work on GitHub <Icon name="arrow-right" /></a>
				<a class="c-btn c-btn--secondary" href={docs}>Read the docs</a>
			</div>
		</div>
		<figure class="hero__art">
			<img
				src={openHouse}
				alt="A document, a dashboard, a site and a picture join a cloud with an open door, lit from inside."
				width="1200"
				height="800"
			/>
		</figure>
	</section>

	<section id="why" class="section container" aria-labelledby="why-title">
		<header class="section__head">
			<p class="c-label">Why Cahut</p>
			<h2 id="why-title" class="c-h1">The file is going away.</h2>
			<p class="lead">
				Word, PowerPoint and Excel were designed for humans who write, lay out and calculate by hand. When an AI
				produces the content, it naturally produces living pages, each with its own address.
			</p>
			<p>
				You no longer send an attachment, you share a link: the page updates, takes comments, keeps its versions, and
				exports to PDF or PowerPoint for whoever still needs a file.
			</p>
		</header>
		<h3 class="c-h3 subhead">Today, what AIs make has no home.</h3>
		<ul class="problems" role="list">
			{
				problems.map(({ title, text }) => (
					<li>
						<h4 class="c-h4">{title}</h4>
						<p class="c-muted">{text}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="statement" data-theme="dark" aria-labelledby="statement-title">
		<div class="container">
			<div class="statement__text">
				<h2 id="statement-title" class="c-h1">Your AIs make it, Cahut keeps it alive.</h2>
				<p class="lead">
					Everything they produce is published, shared, organized and protected in one place, in your colors, on your
					server, whatever the AI.
				</p>
				<p class="c-muted">
					Cahut does not create content, it hosts it. It does not compete with AIs or creation tools: it is the
					neutral, self-hosted home where their work lives.
				</p>
			</div>
			<ol class="layers" role="list">
				{
					layers.map(({ layer, who, what }) => (
						<li class="c-card">
							<p class="c-label">{layer}</p>
							<h3 class="c-h4">{who}</h3>
							<p class="c-muted">{what}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section id="how-it-works" class="section container" aria-labelledby="how-title">
		<header class="section__head">
			<p class="c-label">How it works</p>
			<h2 id="how-title" class="c-h1">The AIs stay outside.</h2>
			<p class="lead">
				They connect to Cahut over MCP, drop their work through bounded operations, then disconnect. No AI model runs
				on the server.
			</p>
		</header>

		<div class="flow" role="group" aria-label="From the AIs to the readers">
			<div class="flow__node">
				<p class="c-label">Create</p>
				<p class="flow__title">The AIs</p>
				<p class="c-small c-muted">Claude, ChatGPT, Mistral, Copilot</p>
			</div>
			<p class="flow__link"><span class="c-mono">MCP</span><Icon name="arrow-right" size={20} /></p>
			<div class="flow__node flow__node--home">
				<p class="c-label">On your server</p>
				<p class="flow__title">Your Cahut</p>
				<p class="c-small c-muted">
					Publish, share, versions, comments, search, export, logbook. Irreversible actions wait for you. Your house
					style, followed by every AI.
				</p>
			</div>
			<p class="flow__link"><span class="c-mono">a link</span><Icon name="arrow-right" size={20} /></p>
			<div class="flow__node">
				<p class="c-label">Read</p>
				<p class="flow__title">Your readers</p>
				<p class="c-small c-muted">Your team, your clients, the public</p>
			</div>
		</div>

		<ol class="steps" role="list">
			<li>
				<h3 class="c-h4">Connect</h3>
				<p>
					Add Cahut to your AI (MCP connector and skill) and authorize it once with OAuth, with the scope you choose.
				</p>
			</li>
			<li>
				<h3 class="c-h4">Create</h3>
				<p>
					Ask your AI for a document, a deck, a dashboard or an app. The skill gives it your formats and house style.
				</p>
			</li>
			<li>
				<h3 class="c-h4">Publish</h3>
				<p>
					The AI publishes a Window to a Room, declares what it does, and gets its address back, such as{' '}
					<code>cahut.example.com/<wbr />marketing/<wbr />q3-review</code>. The previous version is kept.
				</p>
			</li>
			<li>
				<h3 class="c-h4">Share</h3>
				<p>
					You, or the AI within the limits you set, choose who opens each Window: its Room only, everyone in your
					Cahut, anyone with its Key, or the public. Anything irreversible waits for approval in the console.
				</p>
			</li>
			<li>
				<h3 class="c-h4">Live</h3>
				<p>
					Readers open the page in a browser and comment on it. The AI updates it on request. Everything goes to the
					logbook.
				</p>
			</li>
		</ol>
	</section>

	<section id="features" class="section section--muted" aria-labelledby="features-title">
		<div class="container">
			<header class="section__head">
				<p class="c-label">Features</p>
				<h2 id="features-title" class="c-h1">What ships at launch</h2>
				<p class="lead">
					The full scope ships at launch, with no reduced trial version. None of it is usable yet: this is the target.
				</p>
			</header>
			<dl class="features">
				{
					features.map(({ area, text }) => (
						<div>
							<dt class="c-h4">{area}</dt>
							<dd class="c-muted">{text}</dd>
						</div>
					))
				}
			</dl>
			<div class="c-card not-done">
				<h3 class="c-h3">What Cahut does not do</h3>
				<ul>
					{notDone.map((item) => <li>{item}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<section id="knock-first" class="section container" aria-labelledby="knock-title">
		<header class="section__head">
			<p class="c-label">Governance</p>
			<h2 id="knock-title" class="c-h1">Knock first</h2>
			<p class="lead">
				The AI is the intended operator of Cahut, but never without guardrails. What can be undone, it does alone.
				What cannot waits for a human.
			</p>
		</header>

		<div class="rules">
			<div class="c-card rule">
				<p class="c-label">Reversible</p>
				<h3 class="c-h3">The AI does it alone</h3>
				<ul>
					{alone.map((item) => <li>{item}</li>)}
				</ul>
			</div>
			<div class="c-card c-knock rule">
				<p class="c-label">Irreversible</p>
				<h3 class="c-h3">A human approves</h3>
				<ul>
					{approved.map((item) => <li>{item}</li>)}
				</ul>
				<p class="c-small c-muted">
					The request waits in the console, with a notification and an expiry. It says which AI asks, for what, and on
					whose behalf.
				</p>
			</div>
		</div>

		<ol class="principles" role="list">
			{
				principles.map(({ title, text }) => (
					<li>
						<h3 class="c-h4">{title}</h3>
						<p class="c-muted">{text}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section id="vocabulary" class="section section--muted" aria-labelledby="vocabulary-title">
		<div class="container">
			<header class="section__head">
				<p class="c-label">Vocabulary</p>
				<h2 id="vocabulary-title" class="c-h1">The language of the house</h2>
				<p class="lead">Cahut speaks the language of the house, in plain English.</p>
			</header>
			<ul class="vocabulary" role="list">
				{
					vocabulary.map(({ word, picto, meaning, address }) => (
						<li class="c-card word">
							<span class="picto" aria-hidden="true" set:html={picto} />
							<h3 class="c-h4">{word}</h3>
							<p>
								{meaning}
								{address && (
									<>
										{' '}
										<code>{address}</code>
									</>
								)}
							</p>
						</li>
					))
				}
				<li class="c-card word access">
					<h3 class="c-h4">Access</h3>
					<p>Each Window opens to its Room only, to everyone in the Cahut, to anyone with its Key, or to the public.</p>
					<ul class="badges" role="list">
						<li class="c-badge c-badge--room"><Icon name="lock" size={14} />Room only</li>
						<li class="c-badge c-badge--internal"><Icon name="users" size={14} />Internal</li>
						<li class="c-badge c-badge--key"><Icon name="key-round" size={14} />Key</li>
						<li class="c-badge c-badge--public"><Icon name="globe" size={14} />Public</li>
					</ul>
				</li>
			</ul>
		</div>
	</section>

	<section id="roadmap" class="section container" aria-labelledby="roadmap-title">
		<header class="section__head">
			<p class="c-label">Roadmap</p>
			<h2 id="roadmap-title" class="c-h1">Where Cahut stands</h2>
			<p class="lead">
				Cahut is a personal project by Olivier Durand, independent of any company and of any AI vendor. It is written
				in Go, in the open, one step at a time.
			</p>
		</header>
		<div class="roadmap">
			<ol class="milestones" role="list">
				{
					roadmap.map(({ step, current }) => (
						<li aria-current={current ? 'step' : undefined}>
							<p>{step}</p>
							{current && (
								<p class="c-badge c-badge--neutral">
									<span class="c-dot" />
									Under way
								</p>
							)}
						</li>
					))
				}
			</ol>
			<div class="criteria">
				<h3 class="c-h3">Ready for launch when</h3>
				<table>
					<thead>
						<tr>
							<th scope="col">Criterion</th>
							<th scope="col">Threshold</th>
						</tr>
					</thead>
					<tbody>
						{
							criteria.map(({ criterion, threshold }) => (
								<tr>
									<th scope="row">{criterion}</th>
									<td>{threshold}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
		<div class="actions">
			<a class="c-btn c-btn--primary" href={github}>Follow the work on GitHub <Icon name="arrow-right" /></a>
			<a class="c-btn c-btn--secondary" href={docs}>Read the docs</a>
		</div>
	</section>
</Base>

<style>
	.lead {
		font-size: var(--text-lg);
		line-height: var(--leading-lg);
	}
	p {
		margin: 0;
	}
	ul,
	ol,
	dl,
	dd,
	figure {
		margin: 0;
	}
	ul[role='list'],
	ol[role='list'] {
		padding: 0;
		list-style: none;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	/* Hero */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		align-items: center;
		gap: var(--space-12);
		padding-block: var(--space-16) var(--space-20);
	}
	.hero__text {
		display: grid;
		justify-items: start;
		gap: var(--space-6);
	}
	.hero__text > p:not(.status) {
		max-width: var(--measure);
	}
	.status {
		margin: 0;
	}
	.notice {
		max-width: var(--measure);
	}
	/* The illustration has no dark version: it stays on a light panel, white or Paper. */
	.hero__art {
		border-radius: var(--radius-xl);
		overflow: hidden;
		background: var(--cahut-white);
		border: var(--border-width) solid var(--color-border);
	}
	.hero__art img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Sections */
	.section {
		padding-block: var(--space-24);
	}
	.section--muted {
		background: var(--color-surface-muted);
	}
	.section__head {
		display: grid;
		gap: var(--space-4);
		max-width: var(--measure);
		margin-bottom: var(--space-12);
	}
	.subhead {
		margin-bottom: var(--space-6);
	}

	/* Why */
	.problems {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: var(--space-6);
	}
	.problems li {
		display: grid;
		align-content: start;
		gap: var(--space-2);
		padding-top: var(--space-4);
		border-top: 2px solid var(--color-text);
	}

	/* Statement */
	.statement {
		padding-block: var(--space-24);
		background: var(--color-surface);
		color: var(--color-text);
	}
	.statement__text {
		display: grid;
		gap: var(--space-4);
		max-width: var(--measure);
		margin-bottom: var(--space-12);
	}
	.layers {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-6);
	}
	.layers li {
		display: grid;
		align-content: start;
		gap: var(--space-2);
